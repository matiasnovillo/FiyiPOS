                </div>
                <div class="text-center mt-3">
                    <NavLink href="/crear-cuenta" class="lp-btn-primary" style="width:100%;justify-content:center;">
                        <i class="fas fa-rocket"></i> Empezar ahora gratis
                    </NavLink>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ── CTA FINAL ── -->
<section class="lp-cta">
    <div class="container">
        <h2 class="lp-cta-title">¿Listo para modernizar tu negocio?</h2>
        <p class="lp-cta-sub">
            Creá tu cuenta en 30 segundos y empezá a vender hoy mismo.
        </p>
        <div class="lp-hero-actions">
            <NavLink href="/crear-cuenta" class="lp-btn-primary">
                <i class="fas fa-user-plus"></i>
                Crear cuenta gratis
            </NavLink>
            <a href="https://wa.me/543512329541?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20sobre%20FiyiPOS."
               target="_blank"
               class="lp-btn-ghost">
                <i class="fab fa-whatsapp"></i>
                Consultar por WhatsApp
            </a>
        </div>
    </div>
</section>

<_Footer></_Footer>

