            </div>
            <div class="lp-pricing-body">
                <div class="lp-pricing-item">
                    <i class="fas fa-check-circle"></i> Sucursales ilimitadas
                </div>
                <div class="lp-pricing-item">
                    <i class="fas fa-check-circle"></i> Operadores ilimitados
                </div>
                <div class="lp-pricing-item">
                    <i class="fas fa-check-circle"></i> Productos y clientes ilimitados
                </div>
                <div class="lp-pricing-item">
                    <i class="fas fa-check-circle"></i> Inventario, compras y corte de caja
                </div>
                <div class="lp-pricing-item">
                    <i class="fas fa-check-circle"></i> Créditos a clientes
                </div>
                <div class="lp-pricing-item">
                    <i class="fas fa-check-circle"></i> Ticket digital + impresión térmica
                </div>
                <div class="lp-pricing-item">
                    <i class="fas fa-check-circle"></i> Soporte por WhatsApp
                </div>
                <div class="lp-pricing-item">
                    <i class="fas fa-check-circle"></i> Actualizaciones incluidas
                </div>
                <div class="lp-trial-badge">
                    <i class="fas fa-gift me-1"></i>
