    private async Task ReprintLastTicketAsync()
    {
        if (_lastTicket != null)
        {
            _showTicketModal = true;
            return;
        }

        // No sale in this session yet — load last sale from DB
        try
        {
            var sales = await saleRepository.GetAllByStoreIdAsync(posSessionService.StoreId, 1);
            if (!sales.Any())
            {
                await IJSRuntime.InvokeVoidAsync("toastHelper.showWithLimitedTime",
                    "Sin ventas", "No hay ventas registradas en esta sucursal.", "info");
                return;
            }

            var sale = sales[0];
            var details = await saleRepository.GetDetailsBySaleIdAsync(sale.SaleId);
            var invoice = await invoiceRepository.GetBySaleIdAsync(sale.SaleId);
            string? qrImage = null;
            if (invoice?.CAE is not null)
            {
                var config = await companySettingsRepository.GetByStoreIdAsync(posSessionService.StoreId);
                var clientCuit = "";
                if (sale.ClientId.HasValue)
                {
                    var client = await clientRepository.GetOneByClientIdAsync(sale.ClientId.Value);
                    clientCuit = client?.CUIT ?? "";
                }
                var (docTipo, docNro) = DeterminarDocCliente(clientCuit);
                var qrData = new AfipQrComprobanteData
                {
                    Fecha = invoice.InvoiceDate,
                    CuitEmisor = afipQrService.ResolveCuitEmisor(config?.TaxId),
                    PuntoVenta = invoice.PointOfSale,
                    TipoComprobante = invoice.DocumentType,
                    NumeroComprobante = invoice.DocumentNumber,
                    Importe = invoice.Total,
                    TipoDocReceptor = docTipo,
                    NroDocReceptor = docNro,
                    CodigoAutorizacion = afipQrService.ParseCodigoAutorizacion(invoice.CAE)
                };
                qrImage = afipQrService.Generate(qrData).ImageBase64;
            }
            _lastTicket = BuildTicketFromSale(sale, details, invoice, qrImage);
            _showTicketModal = true;
        }
        catch (Exception ex)
        {
            Failure failure = new()
            {
                Active                   = true,
                DateTimeCreation         = DateTime.Now,
                DateTimeLastModification = DateTime.Now,
                UserCreationId           = 1,
                UserLastModificationId   = 1,
                EmergencyLevel           = 1,
                Comment                  = "",
                Message                  = ex.Message,
                Source                   = ex.Source ?? "",
                StackTrace               = ex.StackTrace ?? ""
            };
            await failureRepository.AddAsync(failure);
            await IJSRuntime.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Error", "Hubo un error. Intenta nuevamente", NotificationTypeForJs.Error);
        }
    }

    private TicketVM BuildTicketFromSale(Sale sale, List<SaleDetail> details, Invoice? invoice = null, string? qrImage = null)
    {
        bool isCredit = sale.AmountPaid == 0 && sale.Total > 0;
        return new TicketVM
        {
            StoreName = posSessionService.StoreName,
            CompanyName = ResolveCompanyName(),
            Address = _companyConfig?.Address ?? "",
            Phone = _companyConfig?.Phone ?? "",
            TaxId = FormatTaxId(_companyConfig?.TaxId),
            TaxCondition = _companyConfig?.TaxCondition ?? "",
            DocumentType = invoice is not null ? GetDocumentTypeName(invoice.DocumentType) : "Ticket",
            TicketNumber = sale.TicketNumber,
            IssuedAt = sale.SaleDate,
            ClientName = "",
            PaymentMethod = isCredit ? "Crédito" : "",
            AmountPaid = sale.AmountPaid,
            Change = sale.Change,
            Subtotal = sale.Subtotal,
            TaxAmount = sale.TaxAmount,
            Total = sale.Total,
            Footer = _ticketFooter,
            Currency = _currencySymbol,
            IsCredit = isCredit,
            CAE = invoice?.CAE,
            CAEFechaVencimiento = invoice?.CAEExpirationDate,
            InvoiceNumber = invoice?.InvoiceNumber,
            EsFacturaSimulada = invoice?.Status == "demo",
            QrImageBase64 = qrImage,
            Lines = details.Select(d => new TicketLineVM
            {
                Name = d.ProductNameSnapshot,
                Qty = d.Quantity,
                UnitPrice = d.UnitPrice,
                Subtotal = d.Subtotal,
            }).ToList(),
        };
    }

    private TicketVM BuildTicket(Sale sale, List<CartItem> items, string clientName, string paymentMethodName,
        IssueInvoiceResultDTO? factura = null)
    {
        bool invoiced = factura?.IsSuccess == true || factura?.IsSimulated == true;
        return new TicketVM
        {
            StoreName = posSessionService.StoreName,
            CompanyName = ResolveCompanyName(),
            Address = _companyConfig?.Address ?? "",
            Phone = _companyConfig?.Phone ?? "",
            TaxId = FormatTaxId(_companyConfig?.TaxId),
            TaxCondition = _companyConfig?.TaxCondition ?? "",
            DocumentType = invoiced ? GetDocumentTypeName(factura!.ReceiptType) : "Ticket",
            TicketNumber = sale.TicketNumber,
            IssuedAt = DateTime.Now,
            ClientName = clientName,
            PaymentMethod = paymentMethodName,
            AmountPaid = _isCredit ? 0 : _amountPaid,
            Change = _isCredit ? 0 : _change,
            Subtotal = sale.Subtotal,
            TaxAmount = sale.TaxAmount,
            Total = sale.Total,
            Footer = _ticketFooter,
            Currency = _currencySymbol,
            IsCredit = _isCredit,
            CAE = factura?.IsSuccess == true ? factura.CAE : null,
            CAEFechaVencimiento = factura?.IsSuccess == true ? factura.CAEExpirationDate : null,
            InvoiceNumber = factura?.IsSuccess == true ? factura.ReceiptNumber : null,
            EsFacturaSimulada = factura?.IsSimulated == true,
            QrImageBase64 = factura?.QrImageBase64,
            Lines = items.Select(i => new TicketLineVM
            {
                Name = i.Name,
                Qty = i.Quantity,
                UnitPrice = i.UnitPrice,
                Subtotal = i.Subtotal,
            }).ToList(),
        };
    }

    // ── Low-stock email alert ──────────────────────────
    private async Task SendLowStockAlertsAsync(List<long> productIds, DateTime saleDate)
    {
        try
        {
            if (!productIds.Any()) return;

            long storeId = posSessionService.StoreId;
            bool notifyCashier    = await configRepository.GetValueByStoreAsync(storeId, "send_email_to_cashier_when_araise_low_stock")    == "1";
            bool notifySupervisor = await configRepository.GetValueByStoreAsync(storeId, "send_email_to_supervisor_when_araise_low_stock") == "1";
            bool notifyAdmin      = await configRepository.GetValueByStoreAsync(storeId, "send_email_to_admin_when_araise_low_stock")      == "1";

            if (!notifyCashier && !notifySupervisor && !notifyAdmin) return;

            var products = await productRepository.GetManyByProductIdsAsync(productIds);
            var lowStock = products
                .Where(p => p.MinStock > 0 && p.Stock <= p.MinStock)
                .Select(p => (p.Name, p.Stock, p.MinStock))
                .ToList();

            if (!lowStock.Any()) return;

            var recipients = (await systemUserRepository.GetAllByStoreIdAsync(posSessionService.StoreId))
                .Where(u => u.Active && (
                    (notifyCashier    && u.Role == "cashier")    ||
                    (notifySupervisor && u.Role == "supervisor") ||
                    (notifyAdmin      && u.Role == "admin")))
                .ToList();

            if (!recipients.Any()) return;

            foreach (var user in recipients)
                await email.SendLowStockAlertAsync(user.Username, user.Name,
                    posSessionService.StoreName, saleDate, lowStock);
        }
        catch
        {
            // Don't disrupt the checkout flow if emailing fails
        }
    }

    private static (int DocTipo, long DocNro) DeterminarDocCliente(string clienteCuit)
    {
        var cuit = AfipCertificateHelper.NormalizeCuit(clienteCuit);
        if (cuit.Length == 11)
            return (AfipConstants.DocTipoCuit, long.Parse(cuit));
        if (cuit.Length is >= 7 and <= 8)
            return (AfipConstants.DocTipoDni, long.Parse(cuit));
        return (AfipConstants.DocTipoConsumidorFinal, 0);
    }

    private string ResolveCompanyName() =>
        !string.IsNullOrWhiteSpace(_companyConfig?.CompanyName)
            ? _companyConfig!.CompanyName
            : posSessionService.StoreName;

    private static string FormatTaxId(string? taxId)
    {
        var digits = new string((taxId ?? "").Where(char.IsDigit).ToArray());
        return digits.Length == 11
            ? $"{digits[..2]}-{digits.Substring(2, 8)}-{digits[10..]}"
            : (taxId ?? "");
    }

    private static string GetDocumentTypeName(int documentType) => documentType switch
    {
        1 => "Factura A",
        6 => "Factura B",
        11 => "Factura C",
        2 or 7 or 12 => "Nota de Débito",
        3 or 8 or 13 => "Nota de Crédito",
        _ => "Comprobante"
    };

