    private static string GetPaymentIcon(string name) => name.ToLower() switch
    {
        var n when n.Contains("efectivo") => "fa-money-bill-wave",
        var n when n.Contains("tarjeta") => "fa-credit-card",
        var n when n.Contains("transfer") => "fa-exchange-alt",
        var n when n.Contains("vale") => "fa-ticket-alt",
        _ => "fa-coins"
    };

