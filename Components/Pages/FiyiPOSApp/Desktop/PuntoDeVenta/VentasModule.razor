    private void OnBuscarInput(ChangeEventArgs e)
    {
        _buscarSearch = e.Value?.ToString() ?? "";
        _buscarSelected = null;

        string q = _buscarSearch.Trim();

        if (q == "%" || q == "")
        {
            _buscarResults = q == "%" ? _buscarAll : new();
            return;
        }

        string ql = q.ToLower();
        _buscarResults = _buscarAll
            .Where(p => p.Name.ToLower().Contains(ql) ||
                        p.Barcode.ToLower().Contains(ql))
            .Take(100)
            .ToList();
    }

    private async Task OnBuscarKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _showBuscarModal = false;
            return;
        }
        if (e.Key == "Enter" && _buscarSelected != null)
        {
            await ConfirmBuscarAsync(_buscarSelected);
            return;
        }
        if (e.Key == "ArrowDown" && _buscarResults.Any())
        {
            int cur = _buscarSelected == null ? -1 : _buscarResults.IndexOf(_buscarSelected);
            _buscarSelected = _buscarResults[Math.Min(cur + 1, _buscarResults.Count - 1)];
        }
        if (e.Key == "ArrowUp" && _buscarResults.Any())
        {
            int cur = _buscarSelected == null ? 0 : _buscarResults.IndexOf(_buscarSelected);
            _buscarSelected = _buscarResults[Math.Max(cur - 1, 0)];
        }
    }

    private async Task ConfirmBuscarAsync(Product p)
    {
        var existing = _cart.FirstOrDefault(x => x.ProductId == p.ProductId);
        if (existing != null)
            existing.Quantity++;
        else
        {
            decimal wholesale = p.WholesalePrice ?? 0;
            _cart.Add(new CartItem
            {
                ProductId        = p.ProductId,
                Barcode          = p.Barcode,
                Name             = p.Name,
                SalePrice        = p.SalePrice,
                WholesalePrice   = wholesale,
                UnitPrice        = _isWholesale && wholesale > 0 ? wholesale : p.SalePrice,
                TaxRate          = p.TaxRate > 0 ? p.TaxRate : _defaultTaxRate,
                CostPrice        = p.CostPrice,
                AllowFractional  = p.AllowFractional,
                Stock            = p.Stock,
                UnitAbbreviation = UnitAbbr(p.UnitId),
            });
        }

        _showBuscarModal = false;
    }

