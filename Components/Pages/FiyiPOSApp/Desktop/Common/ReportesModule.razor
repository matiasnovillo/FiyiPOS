@using FiyiPOS.Areas.FiyiPOS.Common.SaleBack.Repositories
@using FiyiPOS.Areas.FiyiPOS.Common.SaleBack.DTOs
@using FiyiPOS.Areas.FiyiPOS.Common.SaleBack.Entities
@using FiyiPOS.Areas.FiyiPOS.Common.SaleDetailBack.Entities
@using FiyiPOS.Areas.FiyiPOS.Common.ConfigBack.Repositories
@using FiyiPOS.Areas.FiyiPOS.Common.CashMovementBack.DTOs
@using FiyiPOS.Areas.FiyiPOS.Common.CashMovementBack.Repositories
@using FiyiPOS.Areas.FiyiPOS.Catalogo.PurchaseBack.Repositories
@using FiyiPOS.Areas.FiyiPOS.Catalogo.PurchaseBack.DTOs
@using FiyiPOS.Services.FiyiPOS
@using System.Text

@inject SaleRepository         saleRepository
@inject CashMovementRepository cashMovementRepository
@inject ConfigRepository       configRepository
@inject PurchaseRepository     purchaseRepository
@inject PosSessionService      posSessionService

<!-- ── HEADER ── -->
<div class="ticket-banner">
    <i class="fas fa-chart-bar"></i>
    REPORTES — Análisis de ventas
</div>

<!-- ── FILTROS ── -->
<div class="rep-filter-bar">
    <div class="rep-filter-group">
        <label class="fs-6">Desde</label>
        <input type="date" class="rep-date-input fs-6"
               @bind="_from" @bind:format="yyyy-MM-dd" />
    </div>
    <div class="rep-filter-group">
        <label class="fs-6">Hasta</label>
        <input type="date" class="rep-date-input fs-6"
               @bind="_to" @bind:format="yyyy-MM-dd" />
    </div>
    <div class="rep-filter-shortcuts">
        <button class="abtn abtn-primary" @onclick="() => SetRange(0)">Hoy</button>
        <button class="abtn abtn-primary" @onclick="() => SetRange(7)">7 días</button>
        <button class="abtn abtn-primary" @onclick="() => SetRange(30)">30 días</button>
        <button class="abtn abtn-primary" @onclick="SetThisMonth">Este mes</button>
    </div>
    <button class="abtn abtn-green" @onclick="GenerateAsync" disabled="@_loading">
        <i class="fas @(_loading ? "fa-spinner fa-spin" : "fa-play")"></i>
        @(_loading ? "Cargando..." : "Generar")
    </button>
    @if (_generated)
    {
        <button class="abtn abtn-sky" @onclick="DownloadReportAsync" disabled="@_downloadingReport">
            <i class="fas @(_downloadingReport ? "fa-spinner fa-spin" : "fa-file-pdf")"></i>
            @(_downloadingReport ? "Generando..." : "Descargar informe")
        </button>
    }
</div>

<!-- ── TABS ── -->
<div class="rep-tabs">
    <button class="rep-tab @(_activeTab == "resumen"   ? "active" : "")" @onclick='() => _activeTab = "resumen"'>
        <i class="fas fa-chart-pie fa-xl"></i> 
        <span class="fs-6">Resumen</span>
    </button>
    <button class="rep-tab @(_activeTab == "productos" ? "active" : "")" @onclick='() => _activeTab = "productos"'>
        <i class="fas fa-boxes fa-xl"></i>
        <span class="fs-6">Productos</span>
    </button>
    <button class="rep-tab @(_activeTab == "operadores" ? "active" : "")" @onclick='() => _activeTab = "operadores"'>
        <i class="fas fa-users fa-xl"></i>
        <span class="fs-6">Operadores</span>
    </button>
    <button class="rep-tab @(_activeTab == "tickets" ? "active" : "")" @onclick='() => _activeTab = "tickets"'>
        <i class="fas fa-receipt fa-xl"></i>
        <span class="fs-6">Tickets</span>
    </button>
    <button class="rep-tab @(_activeTab == "ganancias" ? "active" : "")" @onclick='() => _activeTab = "ganancias"'>
        <i class="fas fa-chart-line fa-xl"></i>
        <span class="fs-6">Ganancias</span>
    </button>
</div>

<!-- ── CONTENIDO ── -->
<div class="rep-content">

    @if (!_generated)
    {
        <div class="empty-state">
            <i class="fas fa-chart-bar fa-xl"></i>
            <p class="fs-6">Seleccioná un rango de fechas y presioná <strong class="fs-6">Generar</strong></p>
        </div>
    }
    else if (_activeTab == "resumen" && _summary != null)
    {
        <!-- KPIs -->
        <div class="rep-kpi-row">
            <div class="rep-kpi">
                <div class="rep-kpi-icon" style="background:rgba(29,78,216,.15);color:#60a5fa;">
                    <i class="fas fa-dollar-sign fa-xl"></i>
                </div>
                <div>
                    <div class="rep-kpi-label fs-6">Total vendido</div>
                    <div class="rep-kpi-value">$@_summary.TotalRevenue.ToString("N2")</div>
                </div>
            </div>
            <div class="rep-kpi">
                <div class="rep-kpi-icon" style="background:rgba(5,150,105,.15);color:#34d399;">
                    <i class="fas fa-receipt fa-xl"></i>
                </div>
                <div>
                    <div class="rep-kpi-label fs-6">N° de ventas</div>
                    <div class="rep-kpi-value">@_summary.SalesCount.ToString("N0")</div>
                </div>
            </div>
            <div class="rep-kpi">
                <div class="rep-kpi-icon" style="background:rgba(139,92,246,.15);color:#a78bfa;">
                    <i class="fas fa-tags fa-xl"></i>
                </div>
                <div>
                    <div class="rep-kpi-label fs-6">Ticket promedio</div>
                    <div class="rep-kpi-value">$@_summary.AverageTicket.ToString("N2")</div>
                </div>
            </div>
        </div>

        <!-- Desglose por método de pago -->
        <div class="rep-section-title">
            <i class="fas fa-credit-card ms-2 me-2 fa-xl"></i>Desglose por método de pago
        </div>
        @if (!_summary.ByPaymentMethod.Any())
        {
            <div class="rep-empty">Sin ventas en el período seleccionado.</div>
        }
        else
        {
            <table class="rep-table">
                <thead>
                    <tr>
                        <th class="fs-6">Método de pago</th>
                        <th class="rep-num fs-6">N° transacciones</th>
                        <th class="rep-num fs-6">Total</th>
                        <th class="rep-num fs-6">% del total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _summary.ByPaymentMethod.OrderByDescending(r => r.Total))
                    {
                        decimal pct = _summary.TotalRevenue > 0
                            ? Math.Round(row.Total / _summary.TotalRevenue * 100, 1) : 0;
                        <tr>
                            <td>
                                <i class="fas @GetPaymentIcon(row.MethodName) me-2 fa-xl" style="color:#6366f1;"></i>
                                <span class="fs-6">@row.MethodName</span>
                            </td>
                            <td class="rep-num fs-6">@row.Count</td>
                            <td class="rep-num rep-bold fs-6">$@row.Total.ToString("N2")</td>
                            <td class="rep-num fs-6">
                                <div class="rep-pct-bar-wrap">
                                    <div class="rep-pct-bar" style="width:@pct%;"></div>
                                    <span class="fs-6">@pct%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        <!-- Movimientos de caja del período -->
        <div class="rep-section-title" style="margin-top:1.2rem;">
            <i class="fas fa-exchange-alt ms-2 me-2 fa-xl"></i>Movimientos de caja del período
        </div>
        @if (!_movements.Any())
        {
            <div class="rep-empty">Sin movimientos de caja en el período seleccionado.</div>
        }
        else
        {
            decimal movIn  = _movements.Where(m => m.Type == "IN").Sum(m => m.Amount);
            decimal movOut = _movements.Where(m => m.Type == "OUT").Sum(m => m.Amount);
            decimal movNet = movIn - movOut;

            <div class="rep-kpi-row">
                <div class="rep-kpi">
                    <div class="rep-kpi-icon" style="background:rgba(5,150,105,.15);color:#34d399;">
                        <i class="fas fa-arrow-down fa-xl"></i>
                    </div>
                    <div>
                        <div class="rep-kpi-label fs-6">Total entradas</div>
                        <div class="rep-kpi-value">$@movIn.ToString("N2")</div>
                    </div>
                </div>
                <div class="rep-kpi">
                    <div class="rep-kpi-icon" style="background:rgba(220,38,38,.15);color:#f87171;">
                        <i class="fas fa-arrow-up fa-xl"></i>
                    </div>
                    <div>
                        <div class="rep-kpi-label fs-6">Total salidas</div>
                        <div class="rep-kpi-value">$@movOut.ToString("N2")</div>
                    </div>
                </div>
                <div class="rep-kpi">
                    <div class="rep-kpi-icon" style="background:rgba(139,92,246,.15);color:#a78bfa;">
                        <i class="fas fa-balance-scale fa-xl"></i>
                    </div>
                    <div>
                        <div class="rep-kpi-label fs-6">Balance neto</div>
                        <div class="rep-kpi-value" style="@(movNet < 0 ? "color:#f87171;" : "")">$@movNet.ToString("N2")</div>
                    </div>
                </div>
            </div>

            <table class="rep-table" style="margin-top:.5rem;">
                <thead>
                    <tr>
                        <th class="fs-6">Tipo</th>
                        <th class="fs-6">Fecha y hora</th>
                        <th class="fs-6">Concepto</th>
                        <th class="fs-6">Método</th>
                        <th class="fs-6">Operador</th>
                        <th class="rep-num fs-6">Importe</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _movements)
                    {
                        <tr>
                            <td>
                                @if (m.Type == "IN")
                                {
                                    <span class="mov-badge-in fs-6"><i class="fas fa-arrow-down me-1"></i>Entrada</span>
                                }
                                else
                                {
                                    <span class="mov-badge-out fs-6"><i class="fas fa-arrow-up me-1"></i>Salida</span>
                                }
                            </td>
                            <td class="fs-6" style="color:var(--text-muted);">@m.MovementDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fs-6">@m.Reason</td>
                            <td class="fs-6">@m.PaymentMethodName</td>
                            <td class="fs-6">@m.OperatorName</td>
                            <td class="rep-num rep-bold fs-6" style="color:@(m.Type == "IN" ? "#059669" : "#dc2626");">
                                @(m.Type == "IN" ? "+" : "−")$@m.Amount.ToString("N2")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    else if (_activeTab == "productos")
    {
        <div class="rep-section-title">
            <i class="fas fa-trophy me-2 fa-xl" style="color:#f59e0b;"></i>
            <span class="fs-6">Top 20 productos más vendidos</span>
        </div>
        @if (!_topProducts.Any())
        {
            <div class="rep-empty fs-6">Sin ventas en el período seleccionado.</div>
        }
        else
        {
            decimal maxUnits = _topProducts.Max(p => p.UnitsSold);
            <table class="rep-table">
                <thead>
                    <tr>
                        <th class="fs-6">#</th>
                        <th class="fs-6">Producto</th>
                        <th class="rep-num fs-6">Unidades</th>
                        <th class="rep-num fs-6">Importe</th>
                        <th class="rep-num fs-6">% unidades</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int rank = 1; }
                    @foreach (var p in _topProducts)
                    {
                        decimal pct = maxUnits > 0
                            ? Math.Round(p.UnitsSold / maxUnits * 100, 1) : 0;
                        <tr>
                            <td class="rep-rank">
                                @if (rank == 1)
                                {
                                    <span class="rep-medal gold fs-6">①</span>
                                }
                                else if (rank == 2)
                                {

                                    <span class="rep-medal silver fs-6">②</span>
                                }
                                else if (rank == 3)
                                {

                                    <span class="rep-medal bronze fs-6">③</span>
                                }
                                else
                                {

                                    <span class="rep-rank-num fs-6">@rank</span>
                                }
                            </td>
                            <td class="fs-6">@p.ProductName</td>
                            <td class="rep-num rep-bold fs-6">@p.UnitsSold.ToString("N2")</td>
                            <td class="rep-num fs-6">$@p.Revenue.ToString("N2")</td>
                            <td class="rep-num fs-6">
                                <div class="rep-pct-bar-wrap">
                                    <div class="rep-pct-bar rep-pct-bar-green" style="width:@pct%;"></div>
                                    <span class="fs-6">@pct%</span>
                                </div>
                            </td>
                        </tr>
                        rank++;
                    }
                </tbody>
            </table>
        }
        <!-- Productos por categoría -->
        @if (_productsByCategory.Any())
        {
            <div class="rep-section-title" style="margin-top:1.4rem;">
                <i class="fas fa-th-list ms-2 me-2 fa-xl"></i>
                <span class="fs-6">Desglose por categoría</span>
            </div>
            @foreach (var group in _productsByCategory)
            {
                decimal catTotal = group.Lines.Sum(l => l.TotalSubtotal);
                <div class="rep-cat-header fs-6">
                    <i class="fas fa-tag me-1"></i>@group.CategoryName
                    <span class="rep-cat-total fs-6">$@catTotal.ToString("N2")</span>
                </div>
                <table class="rep-table rep-cat-table">
                    <thead>
                        <tr>
                            <th class="fs-6">Producto</th>
                            <th class="rep-num fs-6">Cantidad</th>
                            <th class="rep-num fs-6">Importe total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in group.Lines)
                        {
                            <tr>
                                <td class="fs-6">@line.ProductName</td>
                                <td class="rep-num fs-6">@line.TotalQty.ToString("N2")</td>
                                <td class="rep-num rep-bold fs-6">$@line.TotalSubtotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <div class="rep-cat-grand-total fs-6">
                Total general:
                <strong>$@_productsByCategory.Sum(g => g.Lines.Sum(l => l.TotalSubtotal)).ToString("N2")</strong>
            </div>
        }
    }
    else if (_activeTab == "operadores")
    {
        <div class="rep-section-title">
            <i class="fas fa-users me-2 fa-xl"></i>
            <span class="fs-6">Ventas por operador</span>
        </div>
        @if (!_operatorSales.Any())
        {
            <div class="rep-empty fs-6">Sin ventas en el período seleccionado.</div>
        }
        else
        {
            decimal maxSold = _operatorSales.Max(o => o.TotalSold);
            <table class="rep-table">
                <thead>
                    <tr>
                        <th class="fs-6">Operador</th>
                        <th class="rep-num fs-6">N° ventas</th>
                        <th class="rep-num fs-6">Total vendido</th>
                        <th class="rep-num fs-6">Ticket promedio</th>
                        <th class="rep-num fs-6">Participación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var op in _operatorSales)
                    {
                        decimal avg = op.SalesCount > 0
                            ? Math.Round(op.TotalSold / op.SalesCount, 2) : 0;
                        decimal pct = maxSold > 0
                            ? Math.Round(op.TotalSold / maxSold * 100, 1) : 0;
                        <tr>
                            <td>
                                <div class="rep-op-name">
                                    <div class="rep-op-avatar">
                                        @op.OperatorName.Substring(0, 1).ToUpper()
                                    </div>
                                    <span class="fs-6">@op.OperatorName</span>
                                </div>
                            </td>
                            <td class="rep-num fs-6">@op.SalesCount</td>
                            <td class="rep-num rep-bold fs-6">$@op.TotalSold.ToString("N2")</td>
                            <td class="rep-num fs-6">$@avg.ToString("N2")</td>
                            <td class="rep-num fs-6">
                                <div class="rep-pct-bar-wrap">
                                    <div class="rep-pct-bar rep-pct-bar-purple" style="width:@pct%;"></div>
                                    <span class="fs-6">@pct%</span>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    else if (_activeTab == "tickets")
    {
        <div class="rep-section-title">
            <i class="fas fa-receipt me-2 fa-xl"></i>
            <span class="fs-6">Tickets del período — @_saleList.Count resultado@(_saleList.Count != 1 ? "s" : "")</span>
        </div>
        @if (!_saleList.Any())
        {
            <div class="rep-empty fs-6">Sin ventas en el período seleccionado.</div>
        }
        else
        {
            <table class="rep-table rep-tickets-table">
                <thead>
                    <tr>
                        <th class="fs-6">Ticket</th>
                        <th class="fs-6">Fecha y hora</th>
                        <th class="fs-6">Operador</th>
                        <th class="fs-6">Cliente</th>
                        <th class="rep-num fs-6">Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _saleList)
                    {
                        <tr class="rep-ticket-row" @onclick="() => OpenSaleTicketAsync(s)">
                            <td>    
                                <span class="rep-ticket-num fs-6">@s.TicketNumber</span>
                            </td>
                            <td style="color:var(--text-secondary);font-size:1rem;">
                                @s.SaleDate.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                <span class="fs-6">@s.OperatorName</span>
                            </td>
                            <td style="color:var(--text-muted);font-size:1rem;">
                                @(string.IsNullOrWhiteSpace(s.ClientName) ? "—" : s.ClientName)
                            </td>
                            <td class="rep-num rep-bold fs-6">$@s.Total.ToString("N2")</td>
                            <td class="rep-num">
                                @if (s.IsCredit)
                                {
                                    <span class="rep-credit-badge fs-6">Crédito</span>
                                }
                                @if (_loadingTicket && _loadingTicketId == s.SaleId)
                                {
                                    <i class="fas fa-spinner fa-spin fa-xl" style="color:#6366f1;"></i>
                                }
                                else
                                {
                                    <i class="fas fa-eye fa-xl" style="color:#6366f1;opacity:.7;"></i>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    else if (_activeTab == "ganancias")
    {
        @if (!_profitability.Any())
        {
            <div class="empty-state">
                <i class="fas fa-chart-line fa-xl"></i>
                <p class="fs-6">Sin datos de rentabilidad para el período seleccionado.</p>
            </div>
        }
        else
        {
            decimal totalRevenueGross = _summary?.TotalRevenue    ?? 0;   // Ventas con IVA
            decimal totalRevenueNet   = _summary?.TotalRevenueNet ?? 0;   // Ventas sin IVA
            decimal totalCOGS         = _profitability.Sum(l => l.TotalCost);

            decimal profitNet    = totalRevenueNet   - totalCOGS;
            decimal marginNet    = totalRevenueNet   > 0 ? Math.Round(profitNet   / totalRevenueNet   * 100, 1) : 0;
            decimal profitGross  = totalRevenueGross - totalCOGS;
            decimal marginGross  = totalRevenueGross > 0 ? Math.Round(profitGross / totalRevenueGross * 100, 1) : 0;

            <div class="rep-kpi-row">
                <div class="rep-kpi">
                    <div class="rep-kpi-icon" style="background:rgba(29,78,216,.15);color:#60a5fa;">
                        <i class="fas fa-dollar-sign fa-xl"></i>
                    </div>
                    <div>
                        <div class="rep-kpi-label fs-6">Ventas con IVA</div>
                        <div class="rep-kpi-value">$@totalRevenueGross.ToString("N2")</div>
                    </div>
                </div>
                <div class="rep-kpi">
                    <div class="rep-kpi-icon" style="background:rgba(59,130,246,.15);color:#60a5fa;">
                        <i class="fas fa-file-invoice-dollar fa-xl"></i>
                    </div>
                    <div>
                        <div class="rep-kpi-label fs-6">Ventas sin IVA</div>
                        <div class="rep-kpi-value">$@totalRevenueNet.ToString("N2")</div>
                    </div>
                </div>
                <div class="rep-kpi">
                    <div class="rep-kpi-icon" style="background:rgba(220,38,38,.15);color:#f87171;">
                        <i class="fas fa-boxes fa-xl"></i>
                    </div>
                    <div>
                        <div class="rep-kpi-label fs-6">Costo de productos vendidos (COGS)</div>
                        <div class="rep-kpi-value">$@totalCOGS.ToString("N2")</div>
                    </div>
                </div>
                <div class="rep-kpi">
                    <div class="rep-kpi-icon" style="background:@(profitNet >= 0 ? "rgba(5,150,105,.15)" : "rgba(220,38,38,.15)");color:@(profitNet >= 0 ? "#34d399" : "#f87171");">
                        <i class="fas fa-chart-line fa-xl"></i>
                    </div>
                    <div>
                        <div class="rep-kpi-label fs-6">Ganancia bruta (sin IVA)</div>
                        <div class="rep-kpi-value" style="color:@(profitNet >= 0 ? "#059669" : "#dc2626");">
                            $@profitNet.ToString("N2")
                        </div>
                    </div>
                </div>
                <div class="rep-kpi">
                    <div class="rep-kpi-icon" style="background:rgba(139,92,246,.15);color:#a78bfa;">
                        <i class="fas fa-percent fa-xl"></i>
                    </div>
                    <div>
                        <div class="rep-kpi-label fs-6">Margen bruto (sin IVA)</div>
                        <div class="rep-kpi-value" style="color:@(marginNet >= 0 ? "#059669" : "#dc2626");">
                            @marginNet.ToString("N1")%
                        </div>
                    </div>
                </div>
                <div class="rep-kpi">
                    <div class="rep-kpi-icon" style="background:@(profitGross >= 0 ? "rgba(5,150,105,.15)" : "rgba(220,38,38,.15)");color:@(profitGross >= 0 ? "#34d399" : "#f87171");">
                        <i class="fas fa-chart-line fa-xl"></i>
                    </div>
                    <div>
                        <div class="rep-kpi-label fs-6">Ganancia bruta (con IVA)</div>
                        <div class="rep-kpi-value" style="color:@(profitGross >= 0 ? "#059669" : "#dc2626");">
                            $@profitGross.ToString("N2")
                        </div>
                    </div>
                </div>
                <div class="rep-kpi">
                    <div class="rep-kpi-icon" style="background:rgba(139,92,246,.15);color:#a78bfa;">
                        <i class="fas fa-percent fa-xl"></i>
                    </div>
                    <div>
                        <div class="rep-kpi-label fs-6">Margen bruto (con IVA)</div>
                        <div class="rep-kpi-value" style="color:@(marginGross >= 0 ? "#059669" : "#dc2626");">
                            @marginGross.ToString("N1")%
                        </div>
                    </div>
                </div>
            </div>
            <p class="fs-6" style="color:var(--text-muted);margin-top:-.75rem;margin-bottom:1.2rem;">
                <i class="fas fa-info-circle me-1"></i>El margen <strong>sin IVA</strong> es el indicador contable recomendado: el IVA cobrado no es ingreso propio, es un impuesto recaudado para el fisco.
            </p>

            <div class="rep-section-title fs-6">Detalle por producto</div>
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Categoría</th>
                        <th>Producto</th>
                        <th style="text-align:right;">Cant. vendida</th>
                        <th style="text-align:right;">Ingreso (sin IVA)</th>
                        <th style="text-align:right;">Costo total</th>
                        <th style="text-align:right;">Ganancia</th>
                        <th style="text-align:right;">Margen %</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var line in _profitability)
                    {
                        <tr>
                            <td class="fs-6" style="color:var(--text-muted);">@line.CategoryName</td>
                            <td class="fs-6 fw-semibold">@line.ProductName</td>
                            <td class="fs-6" style="text-align:right;">@line.TotalQty.ToString("N2")</td>
                            <td class="fs-6" style="text-align:right;">$@line.TotalRevenue.ToString("N2")</td>
                            <td class="fs-6" style="text-align:right;">$@line.TotalCost.ToString("N2")</td>
                            <td class="fs-6 fw-semibold" style="text-align:right;color:@(line.GrossProfit >= 0 ? "#059669" : "#dc2626");">
                                $@line.GrossProfit.ToString("N2")
                            </td>
                            <td class="fs-6" style="text-align:right;color:@(line.MarginPct >= 0 ? "#059669" : "#dc2626");">
                                @line.MarginPct.ToString("N1")%
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr style="font-weight:700;border-top:2px solid var(--border);">
                        <td colspan="3" class="fs-6">Total</td>
                        <td class="fs-6" style="text-align:right;">$@totalRevenueNet.ToString("N2")</td>
                        <td class="fs-6" style="text-align:right;">$@totalCOGS.ToString("N2")</td>
                        <td class="fs-6" style="text-align:right;color:@(profitNet >= 0 ? "#059669" : "#dc2626");">$@profitNet.ToString("N2")</td>
                        <td class="fs-6" style="text-align:right;color:@(marginNet >= 0 ? "#059669" : "#dc2626");">@marginNet.ToString("N1")%</td>
                    </tr>
                </tfoot>
            </table>
            <p class="fs-6" style="color:var(--text-muted);margin-top:.5rem;">
                * El costo se calcula con el precio de costo actual de cada producto. El detalle por producto usa ingresos <strong>sin IVA</strong>.
            </p>
        }
    }

</div>

<!-- ── Modal: Ticket desde Reportes ── -->
