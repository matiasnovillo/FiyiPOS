        public string Address               { get; set; } = "";
        public string Phone                 { get; set; } = "";
        public string CondicionIVA          { get; set; } = "Monotributista";
        public int    PuntoVenta            { get; set; } = 1;
        public string Ambiente              { get; set; } = "Homologacion";
    }
