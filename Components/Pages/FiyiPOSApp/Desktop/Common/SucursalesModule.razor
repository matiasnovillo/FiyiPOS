        public string  Address      { get; set; } = "";
        public string  Phone        { get; set; } = "";
        public string  TaxId        { get; set; } = "";
        public string  LogoUrl      { get; set; } = "";
        public bool    Active       { get; set; } = true;
        public string? ClaudeApiKey { get; set; }
    }
