@using FiyiPOS.Areas.FiyiPOS.Common.SystemUserBack.Repositories
@using FiyiPOS.Areas.FiyiPOS.Common.SystemUserBack.Entities
@using FiyiPOS.Areas.FiyiPOS.Common.SystemUserStoreBack.Repositories
@using FiyiPOS.Services.FiyiPOS
@using System.Text.RegularExpressions

@inject SystemUserRepository systemUserRepository
@inject SystemUserStoreRepository systemUserStoreRepository
@inject PosSessionService posSessionService
@inject IJSRuntime JS

<!-- ── HEADER ── -->
<div class="header">
    <div class="header-title">GESTIÓN DE OPERADORES</div>
    <div class="header-sub">Administrá los usuarios que acceden al punto de venta de esta sucursal.</div>
</div>

<!-- ── STATS ── -->
<div class="stats-row">
    <div class="stat-card c-primary">
        <div class="stat-label">Total de operadores</div>
        <div class="stat-value">@_operadores.Count</div>
    </div>
    <div class="stat-card c-success">
        <div class="stat-label">Operadores activos</div>
        <div class="stat-value">@_operadores.Count(o => o.Active)</div>
    </div>
    <div class="stat-card c-danger">
        <div class="stat-label">Operadores inactivos</div>
        <div class="stat-value">@_operadores.Count(o => !o.Active)</div>
    </div>
</div>

<!-- ── TOOLBAR ── -->
<div class="toolbar">
    <div class="search-bar">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Buscar por nombre o email..."
               @bind="_searchText" @oninput="OnSearchInput" />
    </div>
    <button class="abtn abtn-blue" @onclick="OpenNewModal">
        <i class="fas fa-user-plus"></i> Nuevo Operador
    </button>
</div>

<!-- ── FILTER CHIPS ── -->
<div class="filter-chips">
    <button class="filter-chip @(_activeFilter == "active" ? "active" : "")"
            @onclick='() => SetActiveFilter("active")'>
        <i class="fas fa-user-check"></i> Activos
        <span>(@_operadores.Count(o => o.Active))</span>
    </button>
    <button class="filter-chip @(_activeFilter == "inactive" ? "active" : "")"
            @onclick='() => SetActiveFilter("inactive")'>
        <i class="fas fa-user-slash"></i> Inactivos
        <span>(@_operadores.Count(o => !o.Active))</span>
    </button>
</div>

<!-- ── LISTA ── -->
<div class="list-container">
    @if (_loading)
    {
        <div class="empty-state">
            <i class="fas fa-spinner fa-spin"></i>
            <p>Cargando operadores...</p>
        </div>
    }
    else if (!_pageOperadores.Any())
    {
        <div class="empty-state">
            <i class="fas fa-users-slash"></i>
            <p>No hay operadores registrados en esta sucursal</p>
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var op in _pageOperadores)
                {
                    <tr>
                        <td>
                            <div class="name-cell">
                                <div class="avatar" style="background:@GetAvatarColor(op.SystemUserId);">
                                    @GetInitial(op)
                                </div>
                                <div>
                                    <div class="entity-link" @onclick="() => OpenEditModal(op)">@op.Name</div>
                                    @if (op.SystemUserId == posSessionService.SystemUserId)
                                    {
                                        <span class="current-badge fs-6">Operador actual</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="fs-6">@op.Username</td>
                        <td>
                            <span class="role-badge role-@op.Role fs-6">
                                @GetRoleLabel(op.Role)
                            </span>
                        </td>
                        <td>
                            @if (op.Active)
                            {
                                <span class="credit-badge credit-yes fs-6">
                                    <i class="fas fa-check-circle me-1"></i>Activo
                                </span>
                            }
                            else
                            {
                                <span class="credit-badge credit-no fs-6">Inactivo</span>
                            }
                        </td>
                        <td class="actions-cell">
                            <button class="abtn abtn-primary" @onclick="() => OpenEditModal(op)">
                                <i class="fas fa-edit"></i> Editar
                            </button>
                            <button class="abtn @(op.Active ? "abtn-danger" : "abtn-success")"
                                    @onclick="() => ToggleActive(op)"
                                    disabled="@(op.SystemUserId == posSessionService.SystemUserId)">
                                <i class="fas @(op.Active ? "fa-user-slash" : "fa-user-check")"></i>
                                @(op.Active ? "Desactivar" : "Activar")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<!-- ── PAGINACIÓN ── -->
@{
    int winStart = Math.Max(1, _pageIndex - 2);
    int winEnd   = Math.Min(_totalPages, _pageIndex + 2);
    if (winEnd - winStart < 4 && _totalPages > 5)
    {
        if (winStart == 1) winEnd   = Math.Min(5, _totalPages);
        else               winStart = Math.Max(1, winEnd - 4);
    }
}
@if (_operadores.Count > 0)
{
    <div class="pg-bar">
        <button class="pg-btn" @onclick="() => GoToPage(_pageIndex - 1)" disabled="@(_pageIndex == 1)">
            <i class="fas fa-chevron-left"></i>
        </button>
        @if (winStart > 1)
        {
            <button class="pg-btn @(1 == _pageIndex ? "pg-active" : "")" @onclick="() => GoToPage(1)">1</button>
            @if (winStart > 2) { <span class="pg-ellipsis">…</span> }
        }
        @for (int p = winStart; p <= winEnd; p++)
        {
            int pg = p;
            <button class="pg-btn @(pg == _pageIndex ? "pg-active" : "")" @onclick="() => GoToPage(pg)">@pg</button>
        }
        @if (winEnd < _totalPages)
        {
            @if (winEnd < _totalPages - 1) { <span class="pg-ellipsis">…</span> }
            <button class="pg-btn @(_totalPages == _pageIndex ? "pg-active" : "")" @onclick="() => GoToPage(_totalPages)">@_totalPages</button>
        }
        <button class="pg-btn" @onclick="() => GoToPage(_pageIndex + 1)" disabled="@(_pageIndex == _totalPages)">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>
}

<!-- ── MODAL ── -->
@if (_showModal)
{
    <div class="modal-overlay">
        <div class="panel">
            <div class="panel-header">
                <span>
                    <i class="fas @(_editingId == null ? "fa-user-plus" : "fa-user-edit") me-2"></i>
                    @(_editingId == null ? "Nuevo operador" : "Editar operador")
                </span>
                <button class="panel-close fs-3" @onclick="CloseModal">×</button>
            </div>

            <div class="panel-body">
                <div class="panel-grid">

                    <div class="field field-full">
                        <label>Nombre completo <span class="required-star">*</span></label>
                        <input type="text" @bind="_form.Name"
                               class="@(_showValidation && string.IsNullOrWhiteSpace(_form.Name) ? "input-invalid" : "")" />
                    </div>

                    <div class="field field-full">
                        <label>Email <span class="required-star">*</span></label>
                        <input type="email" @bind="_form.Email"
                               disabled="@(_editingId != null)"
                               class="@(_showValidation && string.IsNullOrWhiteSpace(_form.Email) ? "input-invalid" : "")" />
                    </div>

                    <div class="field field-full">
                        <label>
                            Contraseña
                            @if (_editingId != null)
                            {
                                <span>(dejar vacío para no cambiar)</span>
                            }
                            else
                            {
                                <span class="required-star">*</span>
                            }
                        </label>
                        <input type="password" @bind="_form.Password"
                               class="@(_showValidation && _editingId == null && string.IsNullOrWhiteSpace(_form.Password) ? "input-invalid" : "")" />
                    </div>

                    <div class="field field-full">
                        <label>Rol <span class="required-star">*</span></label>
                        <select @bind="_form.Role">
                            <option value="cashier">Cajero</option>
                            <option value="supervisor">Supervisor</option>
                            <option value="admin">Administrador</option>
                        </select>
                    </div>

                    @if (_editingId != null)
                    {
                        <div class="field field-full" style="border-top:1px solid var(--pos-border);padding-top:.75rem;margin-top:.25rem;">
                            <label class="check-label @(_editingId == posSessionService.SystemUserId ? "check-label-disabled" : "")">
                                <input type="checkbox" @bind="_form.Active"
                                       disabled="@(_editingId == posSessionService.SystemUserId)" />
                                Operador activo
                            </label>
                            @if (_editingId == posSessionService.SystemUserId)
                            {
                                <p class="check-warn">
                                    <i class="fas fa-lock"></i>
                                    No podés desactivar al operador que está en sesión.
                                </p>
                            }
                        </div>
                    }

                </div>
            </div>

            @if (!string.IsNullOrEmpty(_modalError))
            {
                <div class="dialog-error">
                    <i class="fas fa-exclamation-triangle"></i> @_modalError
                </div>
            }

            <div class="panel-footer">
                <button class="abtn abtn-danger" @onclick="CloseModal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button class="abtn abtn-success" @onclick="SaveOperador" disabled="@_saving">
                    <i class="fas @(_saving ? "fa-spinner fa-spin" : "fa-check")"></i>
                    @(_saving ? "Guardando..." : "Guardar")
                </button>
            </div>
        </div>
    </div>
}

@code {

    private bool   _loading        = true;
    private bool   _showModal      = false;
    private bool   _showValidation = false;
    private bool   _saving         = false;
    private string _searchText     = "";
    private string _activeFilter   = "";
    private string _modalError     = "";
    private long?  _editingId      = null;

    private List<SystemUser> _operadores     = new();
    private List<SystemUser> _pageOperadores = new();
    private int              _pageIndex      = 1;
    private const int        _pageSize       = 10;
    private int              _totalPages     = 1;
    private OperadorFormVM   _form           = new();

    private static readonly string[] _avatarColors =
    [
        "#3d5166", "#5b6abf", "#0f766e", "#b45309",
        "#7c3aed", "#0369a1", "#be185d", "#15803d"
    ];

    private CancellationTokenSource cts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadOperadores();
    }

    private async Task LoadOperadores()
    {
        try
        {
            _loading    = true;
            _operadores = await systemUserRepository.GetAllByStoreIdAsync(posSessionService.StoreId);
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Failure failure = new()
            {
                Active                   = true,
                DateTimeCreation         = DateTime.Now,
                DateTimeLastModification = DateTime.Now,
                UserCreationId           = 1,
                UserLastModificationId   = 1,
                EmergencyLevel           = 1,
                Comment                  = "",
                Message                  = ex.Message,
                Source                   = ex.Source ?? "",
                StackTrace               = ex.StackTrace ?? ""
            };
            await failureRepository.AddAsync(failure);
            await JS.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Error", "Hubo un error. Intenta nuevamente", NotificationTypeForJs.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async void OnSearchInput(ChangeEventArgs e)
    {
        cts.Cancel();
        cts = new();

        try
        {
            await Task.Delay(300, cts.Token);

            _searchText = e.Value?.ToString() ?? "";
            _pageIndex = 1;
            ApplyFilter();
        }
        catch (TaskCanceledException)
        {
            //User still writing, do nothing and wait for the next event to trigger
        }
        catch (Exception)
        {
            await JS.InvokeVoidAsync("toastHelper.showWithLimitedTime",
            "Error", "Error al buscar operadores", "error");
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private void GoToPage(int page)
    {
        if (page < 1 || page > _totalPages || page == _pageIndex) return;
        _pageIndex = page;
        ApplyFilter();
    }

    private void SetActiveFilter(string filter)
    {
        _activeFilter = _activeFilter == filter ? "" : filter;
        _pageIndex    = 1;
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var filtered = _operadores.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            string[] Words = Regex
                    .Replace(_searchText
                    .Trim(), @"\s+", " ")
                    .Split(" ");

            filtered = filtered.Where(u =>
                Words.Any(word => u.Name.ToLower().Contains(word.ToLower())) ||
                Words.Any(word => u.Username.ToLower().Contains(word.ToLower())));
        }

        filtered = _activeFilter switch
        {
            "active"   => filtered.Where(u => u.Active),
            "inactive" => filtered.Where(u => !u.Active),
            _          => filtered
        };

        var list = filtered.ToList();

        _totalPages     = Math.Max(1, (int)Math.Ceiling(list.Count / (double)_pageSize));
        if (_pageIndex > _totalPages) _pageIndex = _totalPages;

        _pageOperadores = list
            .Skip((_pageIndex - 1) * _pageSize)
            .Take(_pageSize)
            .ToList();
    }

    private void OpenNewModal()
    {
        _editingId      = null;
        _form           = new OperadorFormVM();
        _modalError     = "";
        _showValidation = false;
        _showModal      = true;
    }

    private void OpenEditModal(SystemUser op)
    {
        _editingId = op.SystemUserId;
        _form = new OperadorFormVM
        {
            Name     = op.Name,
            Email    = op.Username,
            Password = "",
            Role     = op.Role,
            Active   = op.Active,
        };
        _modalError     = "";
        _showValidation = false;
        _showModal      = true;
    }

    private void CloseModal() => _showModal = false;

    private async Task SaveOperador()
    {
        _showValidation = true;
        _modalError     = "";

        if (string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.Email))
        {
            _modalError = "Nombre y email son requeridos.";
            return;
        }
        if (_editingId == null && string.IsNullOrWhiteSpace(_form.Password))
        {
            _modalError = "La contraseña es requerida.";
            return;
        }
        if (!string.IsNullOrWhiteSpace(_form.Password) && _form.Password.Length < 6)
        {
            _modalError = "La contraseña debe tener al menos 6 caracteres.";
            return;
        }

        _saving = true;
        try
        {
            if (_editingId == null)
            {
                string email = _form.Email.Trim().ToLower();
                if (await systemUserRepository.ExistsByUsernameAsync(email))
                {
                    _modalError = "Ya existe un operador con ese email.";
                    return;
                }

                var nuevo = new SystemUser
                {
                    Name         = _form.Name.Trim(),
                    Username     = email,
                    PasswordHash = FiyiPOS.Library.Security.EncryptString(_form.Password),
                    Role         = _form.Role,
                    Active       = true,
                    CreatedAt    = DateTime.Now,
                };
                await systemUserRepository.AddAsync(nuevo);
                await systemUserStoreRepository.AssignAsync(nuevo.SystemUserId, posSessionService.StoreId);

                await JS.InvokeVoidAsync("toastHelper.showWithLimitedTime",
                    "Éxito", "Operador creado correctamente.", "success");
            }
            else
            {
                var existing = await systemUserRepository.GetOneBySystemUserIdAsync(_editingId.Value);
                if (existing == null) return;

                existing.Name   = _form.Name.Trim();
                existing.Role   = _form.Role;
                existing.Active = _form.Active;
                if (!string.IsNullOrWhiteSpace(_form.Password))
                    existing.PasswordHash = FiyiPOS.Library.Security.EncryptString(_form.Password);

                await systemUserRepository.UpdateAsync(existing);

                await JS.InvokeVoidAsync("toastHelper.showWithLimitedTime",
                    "Éxito", "Operador actualizado correctamente.", "success");
            }

            _showModal = false;
            await LoadOperadores();
        }
        catch (Exception ex)
        {
            Failure failure = new()
            {
                Active                   = true,
                DateTimeCreation         = DateTime.Now,
                DateTimeLastModification = DateTime.Now,
                UserCreationId           = 1,
                UserLastModificationId   = 1,
                EmergencyLevel           = 1,
                Comment                  = "",
                Message                  = ex.Message,
                Source                   = ex.Source ?? "",
                StackTrace               = ex.StackTrace ?? ""
            };
            await failureRepository.AddAsync(failure);
            _modalError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ToggleActive(SystemUser op)
    {
        try
        {
            await systemUserRepository.ToggleActiveAsync(op.SystemUserId);
            string msg = op.Active ? "Operador desactivado." : "Operador activado.";
            await JS.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Éxito", msg, "success");
            await LoadOperadores();
        }
        catch (Exception ex)
        {
            Failure failure = new()
            {
                Active                   = true,
                DateTimeCreation         = DateTime.Now,
                DateTimeLastModification = DateTime.Now,
                UserCreationId           = 1,
                UserLastModificationId   = 1,
                EmergencyLevel           = 1,
                Comment                  = "",
                Message                  = ex.Message,
                Source                   = ex.Source ?? "",
                StackTrace               = ex.StackTrace ?? ""
            };
            await failureRepository.AddAsync(failure);
            await JS.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Error", "Hubo un error. Intenta nuevamente", NotificationTypeForJs.Error);
        }
    }

    private static string GetInitial(SystemUser u) =>
        u.Name.Length > 0 ? u.Name[0].ToString().ToUpper() : "?";

    private static string GetAvatarColor(long id) =>
        _avatarColors[id % _avatarColors.Length];

    private static string GetRoleLabel(string role) => role switch
    {
        "admin"      => "Admin",
        "supervisor" => "Supervisor",
        "cashier"    => "Cajero",
        _            => role
    };

    private class OperadorFormVM
    {
        public string Name     { get; set; } = "";
        public string Email    { get; set; } = "";
        public string Password { get; set; } = "";
        public string Role     { get; set; } = "cashier";
        public bool   Active   { get; set; } = true;
    }
}
