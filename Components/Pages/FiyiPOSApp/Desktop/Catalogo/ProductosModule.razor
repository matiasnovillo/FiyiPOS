    private async Task OnProductImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        string ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext is not (".png" or ".jpg" or ".jpeg"))
        {
            await JS.InvokeVoidAsync("toastHelper.showWithLimitedTime",
                "Archivo inválido", "Solo se permiten imágenes .png o .jpg", NotificationTypeForJs.Error);
            return;
        }

        if (file.Size > MaxImageSizeBytes)
        {
            await JS.InvokeVoidAsync("toastHelper.showWithLimitedTime",
                "Archivo muy grande", "La imagen no puede superar los 5MB", NotificationTypeForJs.Error);
            return;
        }

        using var stream = file.OpenReadStream(MaxImageSizeBytes);
        using var ms     = new MemoryStream();
        await stream.CopyToAsync(ms);
        _pendingImageBytes = ms.ToArray();
        _pendingImageExt   = ext == ".jpeg" ? ".jpg" : ext;

        string mime = _pendingImageExt == ".png" ? "image/png" : "image/jpeg";
        _imagePreviewUrl = $"data:{mime};base64,{Convert.ToBase64String(_pendingImageBytes)}";
    }

    private async Task<string?> SavePendingImageAsync(string? previousImageUrl)
    {
        if (_pendingImageBytes == null) return null;

        string folder = Path.Combine(env.WebRootPath, "uploads", "product");
        Directory.CreateDirectory(folder);

        string fileName = $"{Guid.NewGuid()}{_pendingImageExt}";
        await File.WriteAllBytesAsync(Path.Combine(folder, fileName), _pendingImageBytes);

        DeletePhysicalImage(previousImageUrl);

        return $"/uploads/product/{fileName}";
    }

    private void DeletePhysicalImage(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl)) return;
        try
        {
            string path = Path.Combine(env.WebRootPath, imageUrl.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
            if (File.Exists(path)) File.Delete(path);
        }
        catch (IOException) { /* la imagen huérfana no debe impedir guardar el producto */ }
    }

    private async Task SaveProducto()
    {
        _showValidation = true;
        _modalError     = "";

        if (string.IsNullOrWhiteSpace(_form.Name) || _form.SalePrice <= 0)
        {
            _modalError = "Completa los campos requeridos (Nombre y Precio de venta).";
            return;
        }

        if (!string.IsNullOrWhiteSpace(_form.Barcode))
        {
            var all = await productRepository.GetAllByStoreIdAsync(posSessionService.StoreId);
            bool barcodeRepetido = _editingId == null
                ? all.Any(p => p.Barcode.Equals(_form.Barcode.Trim(), StringComparison.OrdinalIgnoreCase))
                : all.Any(p => p.ProductId != _editingId &&
                               p.Barcode.Equals(_form.Barcode.Trim(), StringComparison.OrdinalIgnoreCase));
            if (barcodeRepetido)
            {
                _modalError = "Ya existe un producto con ese código de barras.";
                return;
            }
        }

        _saving = true;
        try
        {
            string? newImageUrl = await SavePendingImageAsync(_selected?.FirstImageURL);

            if (_editingId == null)
            {
                var nuevo = new Product
                {
                    StoreId         = posSessionService.StoreId,
                    CategoryId      = _form.CategoryId == 0 ? null : _form.CategoryId,
                    UnitId          = _form.UnitId     == 0 ? null : _form.UnitId,
                    Barcode         = _form.Barcode.Trim(),
                    Name            = _form.Name.Trim(),
                    Description     = _form.Description.Trim(),
                    SalePrice       = _form.SalePrice,
                    NightSalePrice  = _form.NightSalePrice,
                    CostPrice       = _form.CostPrice,
                    WholesalePrice  = _form.WholesalePrice == 0 ? null : _form.WholesalePrice,
                    Stock           = _form.Stock,
                    MinStock        = _form.MinStock,
                    MaxStock        = _form.MaxStock == 0 ? null : _form.MaxStock,
                    TaxRate         = _form.TaxRate,
                    AllowFractional = _form.AllowFractional,
                    Active          = _form.Active,
                    IsAvailableToSellOnline = _form.IsAvailableToSellOnline,
                    FirstImageURL   = newImageUrl ?? string.Empty,
                    CreatedAt       = DateTime.Now,
                };
                await productRepository.AddAsync(nuevo);
                await JS.InvokeVoidAsync("toastHelper.showWithLimitedTime",
                    "Éxito", "Producto agregado correctamente.", "success");
            }
            else
            {
                _selected!.CategoryId      = _form.CategoryId == 0 ? null : _form.CategoryId;
                _selected.UnitId           = _form.UnitId     == 0 ? null : _form.UnitId;
                _selected.Barcode          = _form.Barcode.Trim();
                _selected.Name             = _form.Name.Trim();
                _selected.Description      = _form.Description.Trim();
                _selected.SalePrice        = _form.SalePrice;
                _selected.NightSalePrice   = _form.NightSalePrice;
                _selected.CostPrice        = _form.CostPrice;
                _selected.WholesalePrice   = _form.WholesalePrice == 0 ? null : _form.WholesalePrice;
                _selected.Stock            = _form.Stock;
                _selected.MinStock         = _form.MinStock;
                _selected.MaxStock         = _form.MaxStock == 0 ? null : _form.MaxStock;
                _selected.TaxRate          = _form.TaxRate;
                _selected.AllowFractional  = _form.AllowFractional;
                _selected.Active           = _form.Active;
                _selected.IsAvailableToSellOnline = _form.IsAvailableToSellOnline;
                if (newImageUrl != null) _selected.FirstImageURL = newImageUrl;
                _selected.UpdatedAt        = DateTime.Now;
                await productRepository.UpdateAsync(_selected);
                await JS.InvokeVoidAsync("toastHelper.showWithLimitedTime",
                    "Éxito", "Producto actualizado correctamente.", "success");
            }

            _showModal = false;
            await LoadProductos();
        }
        catch (Exception ex)
        {
            Failure failure = new()
            {
                Active                   = true,
                DateTimeCreation         = DateTime.Now,
                DateTimeLastModification = DateTime.Now,
                UserCreationId           = 1,
                UserLastModificationId   = 1,
                EmergencyLevel           = 1,
                Comment                  = "",
                Message                  = ex.Message,
                Source                   = ex.Source ?? "",
                StackTrace               = ex.StackTrace ?? ""
            };
            await failureRepository.AddAsync(failure);
            _modalError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

