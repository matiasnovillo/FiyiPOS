    // ── Cambiar precios masivo ─────────────────────────────────────────────
    private bool    _showPriceModal    = false;
    private bool    _pricePreviewReady = false;
    private bool    _priceComputing    = false;
    private bool    _priceSaving       = false;
    private long    _priceCategoryId   = 0;
    private decimal _pricePercent      = 0m;
    private string  _priceRounding     = "none";
    private string  _priceModalError   = "";
    private List<PricePreviewRow> _pricePreview = new();
    private record PricePreviewRow(long ProductId, string Name, decimal CurrentPrice, decimal NewPrice);

    private void OpenPriceChangeModal()
    {
        _priceCategoryId   = 0;
        _pricePercent      = 0m;
        _priceRounding     = "none";
        _pricePreviewReady = false;
        _priceModalError   = "";
        _pricePreview      = new();
        _showPriceModal    = true;
    }

    private void ClosePriceModal() => _showPriceModal = false;

    private async Task ComputePricePreview()
    {
        if (_pricePercent == 0)
        {
            _priceModalError = "El porcentaje no puede ser 0.";
            return;
        }
        _priceModalError = "";
        _priceComputing  = true;
        try
        {
            var all = await productRepository.GetAllByStoreIdAsync(posSessionService.StoreId);
            var filtered = _priceCategoryId == 0
                ? all
                : all.Where(p => p.CategoryId == _priceCategoryId).ToList();

            _pricePreview = filtered
                .Select(p =>
                {
                    decimal newPrice = Math.Max(0.01m, p.SalePrice * (1m + _pricePercent / 100m));
                    newPrice = ApplyPriceRounding(newPrice);
                    return new PricePreviewRow(p.ProductId, p.Name, p.SalePrice, newPrice);
                })
                .ToList();

            _pricePreviewReady = true;
        }
        finally
        {
            _priceComputing = false;
        }
    }

    private decimal ApplyPriceRounding(decimal price) => _priceRounding switch
    {
        ".00" => Math.Round(price, 0, MidpointRounding.AwayFromZero),
        ".99" => Math.Floor(price) + 0.99m,
        ".50" => Math.Round(price * 2m, 0, MidpointRounding.AwayFromZero) / 2m,
        _     => Math.Round(price, 2)
    };

    private static string GetRoundingLabel(string r) => r switch
    {
        ".00" => "al entero",
        ".99" => "al .99",
        ".50" => "al .50",
        _     => "sin redondeo"
    };

    private async Task ApplyPriceChanges()
    {
        _priceSaving = true;
        try
        {
            var all    = await productRepository.GetAllByStoreIdAsync(posSessionService.StoreId);
            var lookup = all.ToDictionary(p => p.ProductId);
            foreach (var row in _pricePreview)
            {
                if (!lookup.TryGetValue(row.ProductId, out var product)) continue;
                product.SalePrice = row.NewPrice;
                product.UpdatedAt = DateTime.Now;
                await productRepository.UpdateAsync(product);
            }
            _showPriceModal = false;
            await JS.InvokeVoidAsync("toastHelper.showWithLimitedTime",
                "Éxito", $"{_pricePreview.Count} precios actualizados correctamente.", "success");
            await LoadProductos();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("toastHelper.showWithLimitedTime",
                "Error", ex.Message, NotificationTypeForJs.Error);
        }
        finally
        {
            _priceSaving = false;
        }
    }

