    private async Task ConfirmDelete()
    {
        _showDeleteModal = false;
        if (_selected == null) return;
        try
        {
            await productRepository.DeleteOneByProductIdAsync(_selected.ProductId);
            DeletePhysicalImage(_selected.FirstImageURL);
            _selected = null;
            await JS.InvokeVoidAsync("toastHelper.showWithLimitedTime",
                "Éxito", "Producto eliminado correctamente.", "success");
            await LoadProductos();
        }
        catch (Exception ex)
        {
            bool isFk = IsForeignKeyViolation(ex);
            if (isFk)
            {
                await JS.InvokeVoidAsync("toastHelper.showWithLimitedTime",
                    "No se puede eliminar",
                    "Este producto tiene ventas, movimientos de inventario u otros registros asociados. " +
                    "Para quitarlo del catálogo podés desactivarlo con el botón 'Desactivar'.",
                    NotificationTypeForJs.Warning);
            }
            else
            {
                Failure failure = new()
                {
                    Active                   = true,
                    DateTimeCreation         = DateTime.Now,
                    DateTimeLastModification = DateTime.Now,
                    UserCreationId           = 1,
                    UserLastModificationId   = 1,
                    EmergencyLevel           = 1,
                    Comment                  = "",
                    Message                  = ex.Message,
                    Source                   = ex.Source ?? "",
                    StackTrace               = ex.StackTrace ?? ""
                };
                await failureRepository.AddAsync(failure);
                await JS.InvokeVoidAsync("toastHelper.showWithLimitedTime",
                    "Error", "Hubo un error al eliminar el producto.", NotificationTypeForJs.Error);
            }
        }
    }

    private static bool IsForeignKeyViolation(Exception ex)
    {
        string msg = ex.Message + (ex.InnerException?.Message ?? "");
        return msg.Contains("REFERENCE constraint", StringComparison.OrdinalIgnoreCase)
            || msg.Contains("FOREIGN KEY",          StringComparison.OrdinalIgnoreCase)
            || msg.Contains("FK_",                  StringComparison.OrdinalIgnoreCase);
    }

