@page "/olvide-password"

@using FiyiPOS.Areas.FiyiPOS.Common.SystemUserBack.Repositories
@using FiyiPOS.Mailing
@using FiyiPOS.Components.Shared.ComponentsForHome

@inject SystemUserRepository systemUserRepository
@inject Email                emailService

<PageTitle>Recuperar contraseña | FiyiPOS</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="container position-sticky z-index-sticky top-0">
    <div class="row">
        <div class="col-12">
            <_NavBar></_NavBar>
        </div>
    </div>
</div>

<div class="page-header min-vh-100 lp-page-bg">
    <div class="container mb-4">
        <div class="row mt-n4 justify-content-center">
            <div class="col-xl-4 col-lg-5 col-md-7 mx-auto">
                <div class="card mt-8">
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="bg-gradient-primary shadow-primary border-radius-lg py-3 pe-1 text-center py-4">
                            @if (_success)
                            {
                                <h4 class="fw-bold text-white mt-1">
                                    <i class="fas fa-envelope-open-text me-2"></i>¡Revisá tu correo!
                                </h4>
                                <p class="mb-1 fs-6 text-white">
                                    Si el email está registrado, te enviamos un enlace para restablecer tu contraseña.
                                </p>
                            }
                            else
                            {
                                <h4 class="fw-bold text-white mt-1">
                                    ¿Olvidaste tu contraseña?
                                </h4>
                                <p class="mb-1 fs-6 text-white">
                                    Ingresá tu email y te enviamos un enlace para restablecerla
                                </p>
                            }
                        </div>
                    </div>
                    <div class="card-body">
                        @if (_success)
                        {
                            <div class="text-center py-3">
                                <p class="fs-6 text-muted mb-3">
                                    Hacé clic en el enlace del correo para crear una nueva contraseña.<br>
                                    Si no lo ves, revisá la carpeta de spam. El enlace expira en 1 hora.
                                </p>
                                <NavLink href="/entrar" class="btn bg-gradient-primary w-100 fs-6">
                                    Volver al inicio de sesión
                                </NavLink>
                            </div>
                        }
                        else
                        {
                            <div class="text-start">
                                <div class="input-group input-group-static mb-3">
                                    <label for="email">
                                        <i class="fas fa-envelope fa-xl"></i>&nbsp;
                                        <span class="fs-6">Email</span>
                                    </label>
                                    <input type="email"
                                           id="email"
                                           class="form-control fs-6"
                                           @bind="_email"
                                           @onkeydown="OnEmailKeyDown" />
                                </div>

                                @if (!string.IsNullOrEmpty(_errorMessage))
                                {
                                    <div class="alert alert-warning fs-6 py-2 px-3 mb-3">
                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                        @_errorMessage
                                    </div>
                                }

                                <div class="container text-center">
                                    <button id="btn-send-reset" type="button" @onclick="Submit"
                                            class="btn btn-primary mt-3 fs-6" disabled="@_working">
                                        <i class="fas @(_working ? "fa-spinner fa-spin" : "fa-paper-plane") me-1"></i>
                                        @(_working ? "Enviando..." : "Enviar enlace")
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="card-footer text-center pt-0 px-lg-2 px-1">
                        <p class="mb-4 fs-6 mx-auto">
                            ¿Ya te acordaste?
                            <NavLink href="/entrar" class="text-primary text-gradient fw-bold fs-6">
                                Iniciar sesión
                            </NavLink>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<_Footer></_Footer>

@code {

    private string _email        = "";
    private string _errorMessage = "";
    private bool   _success      = false;
    private bool   _working      = false;

    private async Task OnEmailKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    private async Task Submit()
    {
        if (_working) return;
        _errorMessage = "";
        _working      = true;

        try
        {
            if (string.IsNullOrWhiteSpace(_email))
            {
                _errorMessage = "Ingresá tu email.";
                return;
            }

            string username = _email.Trim().ToLower();
            var    user      = await systemUserRepository.GetOneByUsernameAsync(username);

            // Por seguridad, no revelamos si el email existe o no: la respuesta
            // visible es siempre la misma. Solo se envía correo si el usuario existe.
            if (user != null)
            {
                string   token     = Guid.NewGuid().ToString("N");
                DateTime expiresAt = DateTime.Now.AddHours(1);

                await systemUserRepository.SetPasswordResetTokenAsync(user.SystemUserId, token, expiresAt);

                string baseUri  = NavigationManager.BaseUri.TrimEnd('/');
                string resetUrl = $"{baseUri}/restablecer-password?token={token}";
                await emailService.SendPasswordResetEmailAsync(user.Username, user.Name, resetUrl);
            }

            _success = true;
        }
        catch (Exception ex)
        {
            await failureRepository.AddAsync(new Failure
            {
                Active                   = true,
                DateTimeCreation         = DateTime.Now,
                DateTimeLastModification = DateTime.Now,
                UserCreationId           = 1,
                UserLastModificationId   = 1,
                EmergencyLevel           = 1,
                Comment                  = "",
                Message                  = ex.Message,
                Source                   = ex.Source    ?? "",
                StackTrace               = ex.StackTrace ?? "",
            });
            _errorMessage = "Ocurrió un error inesperado. Intentá nuevamente.";
        }
        finally
        {
            _working = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
