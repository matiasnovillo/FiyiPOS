@page "/404"

<PageTitle>404 — Página no encontrada</PageTitle>

<FiyiPOS.Components.Shared.ComponentsForHome._NavBar></FiyiPOS.Components.Shared.ComponentsForHome._NavBar>

<div class="page-header min-vh-100 lp-page-bg">
    <div class="container my-auto">
        <div class="row justify-content-center">
            <div class="col-xl-4 col-lg-5 col-md-7 mx-auto">
                <div class="card mt-8 text-center">
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="bg-gradient-primary shadow-primary border-radius-lg py-4 text-center">
                            <h1 class="fw-bold text-white mb-1" style="font-size:4rem;letter-spacing:.1em;">404</h1>
                            <p class="mb-0 fs-6 text-white opacity-8">Página no encontrada</p>
                        </div>
                    </div>
                    <div class="card-body py-4 px-4">
                        <i class="fas fa-compass fa-3x text-secondary mb-3 d-block"></i>
                        <p class="fs-6 text-muted mb-4">
                            La página que buscás no existe o fue movida a otra dirección.
                        </p>
                        <NavLink class="btn bg-gradient-primary fs-6" href="/">
                            <i class="fas fa-home me-1"></i> Volver al inicio
                        </NavLink>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<FiyiPOS.Components.Shared.ComponentsForHome._Footer></FiyiPOS.Components.Shared.ComponentsForHome._Footer>
