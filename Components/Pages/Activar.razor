@page "/activar"

@using FiyiPOS.Areas.FiyiPOS.Common.SystemUserBack.Repositories
@using FiyiPOS.Components.Shared.ComponentsForHome

@inject SystemUserRepository systemUserRepository
@inject NavigationManager    NavigationManager

<PageTitle>Activar cuenta | FiyiPOS</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="container position-sticky z-index-sticky top-0">
    <div class="row">
        <div class="col-12">
            <_NavBar></_NavBar>
        </div>
    </div>
</div>

<div class="page-header min-vh-100 lp-page-bg">
    <div class="container mb-4">
        <div class="row mt-n4 justify-content-center">
            <div class="col-xl-4 col-lg-5 col-md-7 mx-auto">
                <div class="card mt-8">
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="bg-gradient-primary shadow-primary border-radius-lg py-4 text-center">
                            <h4 class="font-weight-bolder text-white mt-1">
                                @if (_state == "loading")      { <span>Verificando...</span>      }
                                else if (_state == "success")  { <span>¡Cuenta activada!</span>   }
                                else if (_state == "already")  { <span>Ya estaba activa</span>    }
                                else                           { <span>Enlace inválido</span>      }
                            </h4>
                        </div>
                    </div>

                    <div class="card-body text-center py-5">

                        @if (_state == "loading")
                        {
                            <div class="spinner-border text-primary" role="status"
                                 style="width:2.5rem;height:2.5rem;">
                                <span class="visually-hidden  fs-6">Cargando...</span>
                            </div>
                            <p class="text-muted mt-3 fs-6">Validando tu enlace de activación...</p>
                        }
                        else if (_state == "success")
                        {
                            <i class="fas fa-check-circle" style="color: var(--pos-success)"></i>
                            <p class="mt-3">
                                Tu cuenta fue activada correctamente.<br>
                                Ya podés iniciar sesión con tu email y contraseña.
                            </p>
                            <NavLink href="/entrar" class="btn bg-gradient-primary mt-2 w-100 fs-6">
                                Ir al inicio de sesión
                            </NavLink>
                        }
                        else if (_state == "already")
                        {
                            <i class="fas fa-info-circle" style="color: var(--pos-success)"></i>
                            <p class="mt-3 fs-6">
                                Esta cuenta ya estaba activada.<br>
                                Podés iniciar sesión normalmente.
                            </p>
                            <NavLink href="/entrar" class="btn bg-gradient-primary mt-2 w-100 fs-6">
                                Ir al inicio de sesión
                            </NavLink>
                        }
                        else
                        {
                            <i class="fas fa-times-circle fa-xl" style="color: var(--pos-danger)"></i>
                            <p class="mt-3 text-muted fs-6">
                                El enlace de activación no es válido o ya fue utilizado.
                            </p>
                            <NavLink href="/crear-cuenta" class="btn bg-gradient-primary mt-2 w-100 fs-6">
                                Crear cuenta nueva
                            </NavLink>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string _state = "loading";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (string.IsNullOrWhiteSpace(Token))
        {
            _state = "invalid";
            StateHasChanged();
            return;
        }

        var user = await systemUserRepository.GetOneByActivationTokenAsync(Token);

        if (user == null)
        {
            _state = "invalid";
            StateHasChanged();
            return;
        }

        if (user.Active)
        {
            _state = "already";
            StateHasChanged();
            return;
        }

        await systemUserRepository.ActivateByTokenAsync(Token);
        _state = "success";
        StateHasChanged();
    }
}
