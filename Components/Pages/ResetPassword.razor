@page "/restablecer-password"

@using FiyiPOS.Areas.FiyiPOS.Common.SystemUserBack.Repositories
@using FiyiPOS.Components.Shared.ComponentsForHome

@inject SystemUserRepository systemUserRepository

<PageTitle>Restablecer contraseña | FiyiPOS</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="container position-sticky z-index-sticky top-0">
    <div class="row">
        <div class="col-12">
            <_NavBar></_NavBar>
        </div>
    </div>
</div>

<div class="page-header min-vh-100 lp-page-bg">
    <div class="container mb-4">
        <div class="row mt-n4 justify-content-center">
            <div class="col-xl-4 col-lg-5 col-md-7 mx-auto">
                <div class="card mt-8">
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="bg-gradient-primary shadow-primary border-radius-lg py-4 text-center">
                            <h4 class="fw-bold text-white mt-1">
                                @if (_state == "loading")      { <span>Verificando...</span>          }
                                else if (_state == "form")     { <span>Nueva contraseña</span>         }
                                else if (_state == "success")  { <span>¡Contraseña actualizada!</span> }
                                else                            { <span>Enlace inválido</span>          }
                            </h4>
                        </div>
                    </div>

                    <div class="card-body">

                        @if (_state == "loading")
                        {
                            <div class="text-center py-5">
                                <div class="spinner-border text-primary" role="status"
                                     style="width:2.5rem;height:2.5rem;">
                                    <span class="visually-hidden fs-6">Cargando...</span>
                                </div>
                                <p class="text-muted mt-3 fs-6">Validando tu enlace...</p>
                            </div>
                        }
                        else if (_state == "form")
                        {
                            <div class="text-start">
                                <div class="input-group input-group-static mb-3">
                                    <label for="new-password">
                                        <i class="fas fa-key fa-xl"></i>&nbsp;
                                        <span class="fs-6">Nueva contraseña</span>
                                    </label>
                                    <input type="password"
                                           id="new-password"
                                           class="form-control fs-6"
                                           @bind="_password"
                                           autocomplete="new-password" />
                                </div>
                                <div class="input-group input-group-static mb-3">
                                    <label for="confirm-password">
                                        <i class="fas fa-key fa-xl"></i>&nbsp;
                                        <span class="fs-6">Confirmar contraseña</span>
                                    </label>
                                    <input type="password"
                                           id="confirm-password"
                                           class="form-control fs-6"
                                           @bind="_confirmPassword"
                                           autocomplete="new-password"
                                           @onkeydown="OnPasswordKeyDown" />
                                </div>

                                @if (!string.IsNullOrEmpty(_errorMessage))
                                {
                                    <div class="alert alert-warning fs-6 py-2 px-3 mb-3">
                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                        @_errorMessage
                                    </div>
                                }

                                <div class="container text-center">
                                    <button id="btn-reset-password" type="button" @onclick="Submit"
                                            class="btn btn-primary mt-3 fs-6" disabled="@_working">
                                        <i class="fas @(_working ? "fa-spinner fa-spin" : "fa-check") me-1"></i>
                                        @(_working ? "Guardando..." : "Guardar nueva contraseña")
                                    </button>
                                </div>
                            </div>
                        }
                        else if (_state == "success")
                        {
                            <div class="text-center py-3">
                                <i class="fas fa-check-circle" style="color: var(--pos-success)"></i>
                                <p class="mt-3 fs-6">
                                    Tu contraseña fue actualizada correctamente.<br>
                                    Ya podés iniciar sesión con tu nueva contraseña.
                                </p>
                                <NavLink href="/entrar" class="btn bg-gradient-primary mt-2 w-100 fs-6">
                                    Ir al inicio de sesión
                                </NavLink>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <i class="fas fa-times-circle fa-xl" style="color: var(--pos-danger)"></i>
                                <p class="mt-3 text-muted fs-6">
                                    El enlace de recuperación no es válido o ya expiró.
                                </p>
                                <NavLink href="/olvide-password" class="btn bg-gradient-primary mt-2 w-100 fs-6">
                                    Solicitar un enlace nuevo
                                </NavLink>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<_Footer></_Footer>

@code {

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private string _state           = "loading";
    private string _password        = "";
    private string _confirmPassword = "";
    private string _errorMessage    = "";
    private bool   _working         = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (string.IsNullOrWhiteSpace(Token))
        {
            _state = "invalid";
            StateHasChanged();
            return;
        }

        var user = await systemUserRepository.GetOneByPasswordResetTokenAsync(Token);

        if (user == null || user.PasswordResetTokenExpiresAt == null ||
            user.PasswordResetTokenExpiresAt < DateTime.Now)
        {
            _state = "invalid";
            StateHasChanged();
            return;
        }

        _state = "form";
        StateHasChanged();
    }

    private async Task OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    private async Task Submit()
    {
        if (_working) return;
        _errorMessage = "";
        _working      = true;

        try
        {
            if (string.IsNullOrWhiteSpace(_password))
            {
                _errorMessage = "Ingresá tu nueva contraseña.";
                return;
            }

            if (_password.Length < 6)
            {
                _errorMessage = "La contraseña debe tener al menos 6 caracteres.";
                return;
            }

            if (_password != _confirmPassword)
            {
                _errorMessage = "Las contraseñas no coinciden.";
                return;
            }

            string encryptedPassword = FiyiPOS.Library.Security.EncryptString(_password);
            bool   ok = await systemUserRepository.ResetPasswordByTokenAsync(Token!, encryptedPassword);

            if (!ok)
            {
                _state = "invalid";
                return;
            }

            _state = "success";
        }
        catch (Exception ex)
        {
            await failureRepository.AddAsync(new Failure
            {
                Active                   = true,
                DateTimeCreation         = DateTime.Now,
                DateTimeLastModification = DateTime.Now,
                UserCreationId           = 1,
                UserLastModificationId   = 1,
                EmergencyLevel           = 1,
                Comment                  = "",
                Message                  = ex.Message,
                Source                   = ex.Source    ?? "",
                StackTrace               = ex.StackTrace ?? "",
            });
            _errorMessage = "Ocurrió un error inesperado. Intentá nuevamente.";
        }
        finally
        {
            _working = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
