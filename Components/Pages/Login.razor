@page "/entrar"

@using FiyiPOS.Services
@using FiyiPOS.Services.System
@using FiyiPOS.Services.FiyiPOS
@using FiyiPOS.Areas.FiyiPOS.Common.SystemUserBack.Repositories
@using FiyiPOS.Areas.FiyiPOS.Common.SystemUserBack.Entities
@using FiyiPOS.Areas.FiyiPOS.Common.StoreBack.Entities
@using FiyiPOS.Areas.FiyiPOS.Common.SystemUserStoreBack.Repositories
@using FiyiPOS.Areas.FiyiPOS.Common.AttendanceBack.Repositories

@inject CookieService cookieService
@inject AttendanceRepository attendanceRepository
@inject PosSessionService posSessionService
@inject SystemUserRepository systemUserRepository
@inject SystemUserStoreRepository systemUserStoreRepository

@using FiyiPOS.Components.Shared.ComponentsForHome;

<PageTitle>Entrar | FiyiStack</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="container position-sticky z-index-sticky top-0">
    <div class="row">
        <div class="col-12">
            <_NavBar></_NavBar>
        </div>
    </div>
</div>
<div class="page-header min-vh-100 lp-page-bg">
    <div class="container mb-4">
        <div class="row mt-n4 justify-content-center">
            <div class="col-xl-4 col-lg-5 col-md-7 mx-auto">
                <div class="card mt-8">
                    <div class="card-header p-0 position-relative mt-n4 mx-3 z-index-2">
                        <div class="bg-gradient-primary shadow-primary border-radius-lg py-3 pe-1 text-center py-4">
                            <h4 class="fw-bold text-white mt-1">
                                Acceda ahora
                            </h4>
                            <p class="mb-1 fs-6 text-white">
                                Ingrese sus credenciales
                            </p>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (_step == "credentials")
                        {
                            <div class="text-start">
                                <div class="input-group input-group-static mb-3">
                                    <label for="email">
                                        <i class="fas fa-envelope fa-xl"></i>&nbsp;
                                        <span class="fs-6">Email</span>
                                    </label>
                                    <input type="email"
                                           id="email"
                                           class="form-control fs-6"
                                           @bind="_email" />
                                </div>
                                <div class="input-group input-group-static mb-3">
                                    <label for="password">
                                        <i class="fas fa-key fa-xl"></i>&nbsp;
                                        <span class="fs-6">Contraseña</span>
                                    </label>
                                    <input type="password"
                                           id="password"
                                           class="form-control fs-6"
                                           @bind="_password"
                                           @onkeydown="OnPasswordKeyDown" />
                                </div>
                                <div class="container text-center">
                                    <button id="btn-login" type="button" @onclick="Submit"
                                            class="btn btn-primary mt-3 fs-6" disabled="@_isSubmitting">
                                        <i class="fas @(_isSubmitting ? "fa-spinner fa-spin" : "fa-sign-in-alt") me-1"></i>
                                        @(_isSubmitting ? "Ingresando..." : "Ingresar")
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="login-store-picker">
                                <p class="login-store-picker-title fs-6">
                                    <i class="fas fa-store fa-xl me-2"></i>
                                    Selecciona la sucursal
                                </p>
                                @foreach (var store in _storeOptions)
                                {
                                    <button class="login-store-btn fs-6" @onclick="() => PickStore(store)">
                                        <i class="fas fa-map-marker-alt me-2 fa-xl"></i>
                                        @store.Name
                                    </button>
                                }
                                <button class="login-store-back" @onclick='() => _step = "credentials"'>
                                    <i class="fas fa-arrow-left me-1 fa-xl"></i> 
                                    <span class="fs-6">Volver</span>
                                </button>
                            </div>
                        }
                    </div>
                    <div class="card-footer text-center pt-0 px-lg-2 px-1">
                        <p class="mb-4 fs-6 mx-auto">
                            ¿No tienes una cuenta?
                            <NavLink href="/crear-cuenta" class="text-primary text-gradient fw-bold fs-6">
                                Registrarme
                            </NavLink>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<_Footer></_Footer>

@code {

    private string _email        = "";
    private string _password     = "";
    private string _step         = "credentials";
    private bool   _isSubmitting = false;

    private SystemUser?  _authenticatedUser;
    private List<Store>  _storeOptions = new();

    private async Task OnPasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    private async Task Submit()
    {
        if (_isSubmitting) return;
        _isSubmitting = true;
        try
        {
            if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
            {
                await IJSRuntime.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Información", "Complete todos los datos", NotificationTypeForJs.Information);
                return;
            }

            string encryptedPassword = FiyiPOS.Library.Security.EncryptString(_password);

            SystemUser? systemUser = await systemUserRepository
                .GetOneByUsernameAndPasswordAsync(_email.Trim().ToLower(), encryptedPassword);

            if (systemUser != null)
            {
                List<Store> stores = (await systemUserStoreRepository.GetStoresByUserIdAsync(systemUser.SystemUserId))
                    .Where(s => s.Active)
                    .ToList();

                if (stores.Count == 0)
                {
                    await IJSRuntime.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Atención", "El usuario no tiene sucursales asignadas", NotificationTypeForJs.Warning);
                    return;
                }

                if (stores.Count == 1)
                {
                    await CompleteLoginAsync(systemUser, stores[0], stores);
                    return;
                }

                _authenticatedUser = systemUser;
                _storeOptions      = stores;
                _step              = "store-picker";
                return;
            }

            if (await systemUserRepository.ExistsByUsernameAsync(_email.Trim().ToLower()) &&
                !await systemUserRepository.IsActiveByUsernameAsync(_email.Trim().ToLower()))
            {
                await IJSRuntime.InvokeVoidAsync("toastHelper.showWithLimitedTime",
                    "Cuenta sin activar",
                    "Revisá tu correo y hacé clic en el enlace de activación.",
                    NotificationTypeForJs.Warning);
                return;
            }

            await IJSRuntime.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Atención", "Usuario o contraseña incorrectos", NotificationTypeForJs.Warning);
        }
        catch (Exception ex)
        {
            Failure failure = new()
            {
                Active                   = true,
                DateTimeCreation         = DateTime.Now,
                DateTimeLastModification = DateTime.Now,
                UserCreationId           = 1,
                UserLastModificationId   = 1,
                EmergencyLevel           = 1,
                Comment                  = "",
                Message                  = ex.Message,
                Source                   = ex.Source ?? "",
                StackTrace               = ex.StackTrace ?? ""
            };
            await failureRepository.AddAsync(failure);
            await IJSRuntime.InvokeVoidAsync("toastHelper.showWithLimitedTime", "Error", "Hubo un error. Intenta nuevamente", NotificationTypeForJs.Error);
        }
        finally
        {
            _isSubmitting = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PickStore(Store store)
    {
        await CompleteLoginAsync(_authenticatedUser!, store, _storeOptions);
    }

    private async Task CompleteLoginAsync(SystemUser systemUser, Store store, List<Store> allStores)
    {
        posSessionService.SetSession(
            systemUser.SystemUserId,
            store.StoreId,
            store.Name,
            systemUser.Name,
            systemUser.Role);
        posSessionService.SetAccessibleStores(allStores);
        posSessionService.SetBillingDueDate(store.BillingDueDate);
        await cookieService.SetEncryptedPosSystemUserIdCookieAsync(systemUser.SystemUserId.ToString());

        bool forgotCheckout = await attendanceRepository.HasUnclosedSessionAsync(systemUser.SystemUserId, store.StoreId);
        if (forgotCheckout)
        {
            await attendanceRepository.SetCheckOutAsync(systemUser.SystemUserId, store.StoreId);
            posSessionService.SetForgotCheckout(true);
        }

        _ = attendanceRepository.AddCheckInAsync(systemUser.SystemUserId, store.StoreId);
        NavigationManager.NavigateTo("/panel-de-control");
    }
}
