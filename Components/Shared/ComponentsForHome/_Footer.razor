<footer class="lp-footer">
    <div class="lp-footer-grid">

        <!-- Marca -->
        <div class="lp-footer-brand">
            <a href="/" class="lp-footer-logo">
                <div class="lp-footer-logo-icon">
                    <i class="fas fa-cash-register"></i>
                </div>
                <span class="lp-footer-logo-name">FiyiPOS</span>
            </a>
            <p class="lp-footer-tagline">
                El sistema de punto de venta web más simple y completo.
                Vendé, controlá stock y gestioná múltiples sucursales
                desde cualquier navegador.
            </p>
            <div class="lp-footer-social">
                <a href="https://wa.me/543512329541" target="_blank"
                   class="lp-footer-social-btn" title="WhatsApp">
                    <i class="fab fa-whatsapp"></i>
                </a>
            </div>
        </div>

        <!-- Links -->
        <div>
            <div class="lp-footer-col-title">Navegación</div>
            <ul class="lp-footer-links">
                <li>
                    <a href="/">
                        <i class="fas fa-chevron-right"></i> Inicio
                    </a>
                </li>
                <li>
                    <a href="/crear-cuenta">
                        <i class="fas fa-chevron-right"></i> Crear cuenta
                    </a>
                </li>
                <li>
                    <a href="/entrar">
                        <i class="fas fa-chevron-right"></i> Iniciar sesión
                    </a>
                </li>
                <li>
                    <a href="/pagar">
                        <i class="fas fa-chevron-right"></i> Renovar suscripción
                    </a>
                </li>
            </ul>
        </div>

        <!-- Contacto -->
        <div>
            <div class="lp-footer-col-title">Soporte</div>
            <a href="https://wa.me/543512329541?text=Hola%2C%20necesito%20ayuda%20con%20FiyiPOS."
               target="_blank"
               class="lp-footer-contact-item">
                <div class="lp-footer-contact-icon"
                     style="background:rgba(37,211,102,.12);color:#25d366;">
                    <i class="fab fa-whatsapp"></i>
                </div>
                <div>
                    <div style="color:#e2e8f0;font-weight:600;font-size:.82rem;">WhatsApp</div>
                    <div style="font-size:.76rem;">+54 351 232 9541</div>
                </div>
            </a>
            <a href="mailto:soporte@fiyipos.com"
               class="lp-footer-contact-item">
                <div class="lp-footer-contact-icon"
                     style="background:rgba(99,102,241,.12);color:#818cf8;">
                    <i class="fas fa-envelope"></i>
                </div>
                <div>
                    <div style="color:#e2e8f0;font-weight:600;font-size:.82rem;">Email</div>
                    <div style="font-size:.76rem;">soporte@fiyipos.com</div>
                </div>
            </a>
            <div style="margin-top:1rem;padding:.6rem .75rem;background:rgba(26,172,177,.08);
                        border:1px solid rgba(26,172,177,.2);border-radius:8px;font-size:.76rem;
                        line-height:1.5;color:#64748b;">
                <i class="fas fa-clock me-1" style="color:#1aacb1;"></i>
                Respuesta en menos de 24 hs
            </div>
        </div>

    </div>

    <!-- Barra inferior -->
    <div class="lp-footer-bar">
        <span>© @DateTime.Now.Year FiyiPOS. Todos los derechos reservados.</span>
        <span>
            Hecho con <i class="fas fa-heart" style="color:#f43f5e;font-size:.7rem;"></i>
            en Córdoba, Argentina
        </span>
    </div>
</footer>

