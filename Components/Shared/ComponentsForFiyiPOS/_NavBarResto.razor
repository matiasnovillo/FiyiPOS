@* Navbar de FiyiPOS Restó *@

@using FiyiPOS.Services.System
@using FiyiPOS.Services.FiyiPOS
@using FiyiPOS.Areas.FiyiPOS.Common.ConfigBack.Repositories
@using FiyiPOS.Areas.FiyiPOS.Common.AttendanceBack.Repositories

@inject CookieService        cookieService
@inject PosSessionService    posSessionService
@inject ConfigRepository     configRepository
@inject AttendanceRepository attendanceRepository
@inject IJSRuntime           JS

<!-- ── NAV ── -->
<nav class="pos-nav">

    @* ── Dashboard (ítem directo, primero) ── *@
    @if (posSessionService.CanAccess("dashboard"))
    {
        <button class="nav-item" @onclick="NavigateToDashboard">
            <i class="fas fa-tachometer-alt fa-xl"></i>
            <span class="fs-6">Dashboard</span>
        </button>
    }

    @* ── Grupo: Ventas ── *@
    @if (GroupHasAccess(_ventasGroup))
    {
        <div class="nav-group @(_openGroup == "ventas" ? "open" : "")">
            <button class="nav-group-trigger @(GroupIsActive(_ventasGroup) ? "has-active" : "")"
                    @ref="_refVentas"
                    @onclick='() => ToggleGroupAsync("ventas", _refVentas)'>
                <i class="fas fa-cash-register fa-xl"></i>
                <span class="fs-6">Ventas</span>
                <i class="fas fa-chevron-down fa-xl nav-chevron"></i>
            </button>
        </div>
    }

    @* ── Grupo: Catálogo ── *@
    @if (GroupHasAccess(_catalogoGroup))
    {
        <div class="nav-group @(_openGroup == "catalogo" ? "open" : "")">
            <button class="nav-group-trigger @(GroupIsActive(_catalogoGroup) ? "has-active" : "")"
                    @ref="_refCatalogo"
                    @onclick='() => ToggleGroupAsync("catalogo", _refCatalogo)'>
                <i class="fas fa-boxes fa-xl"></i>
                <span class="fs-6">Catálogo</span>
                <i class="fas fa-chevron-down fa-xl nav-chevron"></i>
            </button>
        </div>
    }

    @* ── Grupo: Contactos ── *@
    @if (GroupHasAccess(_contactosGroup))
    {
        <div class="nav-group @(_openGroup == "contactos" ? "open" : "")">
            <button class="nav-group-trigger @(GroupIsActive(_contactosGroup) ? "has-active" : "")"
                    @ref="_refContactos"
                    @onclick='() => ToggleGroupAsync("contactos", _refContactos)'>
                <i class="fas fa-address-book fa-xl"></i>
                <span class="fs-6">Contactos</span>
                <i class="fas fa-chevron-down fa-xl nav-chevron"></i>
            </button>
        </div>
    }

    @* ── Grupo: Admin ── *@
    @if (GroupHasAccess(_adminGroup))
    {
        <div class="nav-group @(_openGroup == "admin" ? "open" : "")">
            <button class="nav-group-trigger @(GroupIsActive(_adminGroup) ? "has-active" : "")"
                    @ref="_refAdmin"
                    @onclick='() => ToggleGroupAsync("admin", _refAdmin)'>
                <i class="fas fa-user-shield fa-xl"></i>
                <span class="fs-6">Administrador</span>
                <i class="fas fa-chevron-down fa-xl nav-chevron"></i>
            </button>
        </div>
    }

    <a class="nav-item nav-guide" href="/GUIA-DE-USO.html" target="_blank">
        <i class="fas fa-book-open fa-xl"></i>
        <span class="fs-6">Guía de uso</span>
    </a>

    <div class="nav-spacer"></div>
    <div class="nav-zoom">
        <button class="nav-zoom-btn" @onclick="ZoomOut" disabled="@(_zoomIndex <= 0)" title="Alejar">
            <i class="fas fa-minus fa-xl"></i>
        </button>
        <span class="nav-zoom-btn fs-6">@ZoomPercent%</span>
        <button class="nav-zoom-btn" @onclick="ZoomIn" disabled="@(_zoomIndex >= 10)" title="Acercar">
            <i class="fas fa-plus fa-xl"></i>
        </button>
    </div>
    <button class="nav-item nav-theme-toggle"
            @onclick="ToggleThemeAsync"
            title="@(_isDark ? "Cambiar a tema claro" : "Cambiar a tema oscuro")">
        <i class="fas @(_isDark ? "fa-sun" : "fa-moon") fa-xl"></i>
    </button>
    <a class="nav-item nav-exit" @onclick="Logout">
        <i class="fas fa-sign-out-alt fa-xl"></i>
        <span class="fs-6">Salir</span>
    </a>
</nav>

@* Los paneles se renderizan FUERA del nav para escapar overflow:hidden *@
@if (_openGroup != null)
{
    <div class="nav-dropdown-overlay" @onclick="CloseGroup"></div>

    <div class="nav-dropdown" style="top:@Px(_dropTop);left:@Px(_dropLeft);">
        @foreach (var s in CurrentGroupItems().Where(posSessionService.CanAccess))
        {
            <button class="nav-dropdown-item @(ActiveSection == s ? "active" : "")"
                    @onclick="() => NavigateAndClose(s)">
                <i class="fas @GetIcon(s) nav-drop-icon fa-xl"></i>
                <span class="fs-6">@GetLabel(s)</span>
            </button>
        }
    </div>
}

@code {
    [Parameter] public string               ActiveSection    { get; set; } = "";
    [Parameter] public EventCallback<string> OnSectionChanged { get; set; }

    // ── Nav groups ──────────────────────────────────────
    private string? _openGroup;
    private double  _dropTop;
    private double  _dropLeft;

    private ElementReference _refVentas;
    private ElementReference _refCatalogo;
    private ElementReference _refContactos;
    private ElementReference _refAdmin;

    private static readonly string[] _ventasGroup    = ["movimientos", "consumointerno", "facturas", "corte", "notepad"];
    private static readonly string[] _catalogoGroup  = ["productos", "inventario", "compras", "promociones"];
    private static readonly string[] _contactosGroup = ["clientes", "proveedores"];
    private static readonly string[] _adminGroup     = ["sucursales", "operadores", "configuracion", "reportes", "esquema", "asistencias", "categorias", "aichat"];

    private bool   GroupHasAccess(string[] items) => items.Any(posSessionService.CanAccess);
    private bool   GroupIsActive(string[]  items) => items.Contains(ActiveSection);
    private string[] CurrentGroupItems() => _openGroup switch
    {
        "ventas"    => _ventasGroup,
        "catalogo"  => _catalogoGroup,
        "contactos" => _contactosGroup,
        "admin"     => _adminGroup,
        _           => [],
    };

    private static string Px(double v) =>
        v.ToString("F0", System.Globalization.CultureInfo.InvariantCulture) + "px";

    private async Task ToggleGroupAsync(string group, ElementReference btnRef)
    {
        if (_openGroup == group) { _openGroup = null; return; }

        try
        {
            var bounds = await JS.InvokeAsync<Bounds>("navDropHelper.getBounds", btnRef);
            _dropTop  = bounds.Bottom;
            _dropLeft = bounds.Left;
        }
        catch
        {
            _dropTop  = 80;
            _dropLeft = 0;
        }

        _openGroup = group;
    }

    private void CloseGroup() => _openGroup = null;

    private async Task NavigateAndClose(string section)
    {
        _openGroup = null;
        await OnSectionChanged.InvokeAsync(section);
    }

    private static string GetIcon(string s) => s switch
    {
        "movimientos"    => "fa-exchange-alt",
        "consumointerno" => "fa-boxes-packing",
        "facturas"       => "fa-file-invoice-dollar",
        "corte"          => "fa-scissors",
        "notepad"        => "fa-sticky-note",
        "productos"      => "fa-box-open",
        "inventario"     => "fa-warehouse",
        "compras"        => "fa-truck",
        "promociones"    => "fa-tags",
        "clientes"       => "fa-users",
        "proveedores"    => "fa-building",
        "sucursales"     => "fa-store",
        "operadores"     => "fa-user-cog",
        "configuracion"  => "fa-cog",
        "reportes"       => "fa-chart-bar",
        "esquema"        => "fa-palette",
        "asistencias"    => "fa-user-clock",
        "categorias"     => "fa-tags",
        "aichat"         => "fa-robot",
        _                => "fa-circle",
    };

    private static string GetLabel(string s) => s switch
    {
        "movimientos"    => "Movimientos",
        "consumointerno" => "Consumo interno",
        "facturas"       => "Facturas",
        "corte"          => "Corte",
        "notepad"        => "Bloc de notas",
        "productos"      => "Productos",
        "inventario"     => "Inventario",
        "compras"        => "Compras",
        "promociones"    => "Promociones",
        "clientes"       => "Clientes",
        "proveedores"    => "Proveedores",
        "sucursales"     => "Sucursales",
        "operadores"     => "Operadores",
        "configuracion"  => "Configuración",
        "reportes"       => "Reportes",
        "esquema"        => "Esquema de colores",
        "asistencias"    => "Asistencias",
        "categorias"     => "Categorías",
        "aichat"         => "AI Chat",
        _                => s,
    };

    // ── Theme toggle & Zoom (mismo comportamiento que _NavBarPuntoDeVenta) ──
    private bool _isDark;
    private bool _themeLoaded;
    private int  _zoomIndex  = 5;
    private int  ZoomPercent => 75 + _zoomIndex * 5;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _themeLoaded) return;
        _themeLoaded = true;
        try
        {
            var configs     = await configRepository.GetSchemeVarsAsync(posSessionService.StoreId);
            var activeTheme = configs.FirstOrDefault(c => c.ConfigKey == "pos_active_theme")?.Value ?? "light";
            _isDark = activeTheme == "dark";

            var prefix = _isDark ? "pos_dark_" : "pos_light_";
            foreach (var c in configs.Where(c => c.ConfigKey.StartsWith(prefix)))
                await JS.InvokeVoidAsync("schemeHelper.applyVar", c.ConfigKey.Replace(prefix, "pos_"), c.Value);

            _zoomIndex = await JS.InvokeAsync<int>("zoomHelper.init");

            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private async Task ZoomIn()  => _zoomIndex = await JS.InvokeAsync<int>("zoomHelper.zoomIn");
    private async Task ZoomOut() => _zoomIndex = await JS.InvokeAsync<int>("zoomHelper.zoomOut");

    private async Task ToggleThemeAsync()
    {
        _isDark = !_isDark;
        try
        {
            var configs = await configRepository.GetSchemeVarsAsync(posSessionService.StoreId);
            var prefix  = _isDark ? "pos_dark_" : "pos_light_";
            var active  = configs.Where(c => c.ConfigKey.StartsWith(prefix)).ToList();
            if (!active.Any()) { _isDark = !_isDark; return; }

            foreach (var c in active)
                await JS.InvokeVoidAsync("schemeHelper.applyVar", c.ConfigKey.Replace(prefix, "pos_"), c.Value);

            var updates = active.ToDictionary(c => c.ConfigKey.Replace(prefix, "pos_"), c => c.Value);
            updates["pos_active_theme"] = _isDark ? "dark" : "light";
            await configRepository.UpdateSchemeVarsAsync(posSessionService.StoreId, updates);
        }
        catch { }
    }

    private void NavigateToDashboard()
    {
        _openGroup = null;
        NavigationManager.NavigateTo("/panel-de-control");
    }

    private async Task Logout()
    {
        if (posSessionService.IsAuthenticated)
            _ = attendanceRepository.SetCheckOutAsync(
                    posSessionService.SystemUserId, posSessionService.StoreId);

        await cookieService.RemovePosSystemUserIdCookieAsync();
        posSessionService.ClearSession();
        NavigationManager.NavigateTo("/");
    }

    private sealed class Bounds
    {
        public double Bottom { get; set; }
        public double Left   { get; set; }
    }
}
