@using FiyiPOS.Services.FiyiPOS
@using FiyiPOS.Areas.FiyiPOS.Common.ConfigBack.Repositories
@using Microsoft.JSInterop
@inject PosSessionService posSessionService
@inject HotkeyService hotkeyService
@inject ConfigRepository configRepository
@inject IJSRuntime JS
@implements IAsyncDisposable

<!-- ── HEADER ── -->
<header class="pos-header">
    <div class="brand">
        <div class="brand-icon"><i class="fas fa-cash-register fa-xl"></i></div>
        <div>
            <div class="brand-name fs-5">FiyiPOS</div>
            <div class="brand-sub fs-6">@Subtitle</div>
        </div>
    </div>

    @if (posSessionService.CanSwitchStore)
    {
        <div class="store-dropdown-wrapper">
            <button class="store-dropdown-trigger" @onclick="ToggleDropdown">
                <i class="fas fa-store me-1"></i>
                @posSessionService.StoreName
                <i class="fas fa-chevron-down ms-1 store-dropdown-chevron @(_dropdownOpen ? "open" : "")"></i>
            </button>
            @if (_dropdownOpen)
            {
                <div class="store-dropdown-menu">
                    @foreach (var store in posSessionService.AccessibleStores)
                    {
                        <button class="store-dropdown-item @(store.StoreId == posSessionService.StoreId ? "active" : "")"
                                @onclick="() => SwitchStore(store)">
                            <i class="fas fa-map-marker-alt me-2"></i>@store.Name
                        </button>
                    }
                </div>
                <div class="store-dropdown-overlay" @onclick="CloseDropdown"></div>
            }
        </div>
    }
    else
    {
        <div class="header-title">
            <i class="fas fa-store me-1"></i>
            @posSessionService.StoreName
        </div>
    }

    <div class="header-user">
        <div class="fs-6"><i class="fas fa-user-circle me-1"></i>Le atiende</div>
        <div class="fs-6">@posSessionService.OperatorName</div>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(_specialMessage))
{
    <div class="special-msg-banner">
        <i class="fas fa-bullhorn"></i>
        <span>@_specialMessage</span>
    </div>
}

@if (posSessionService.ForgotCheckout)
{
    <div class="billing-alert billing-alert-warning" style="cursor:pointer;" @onclick="() => posSessionService.SetForgotCheckout(false)">
        <i class="fas fa-user-clock"></i>
        <span>La última vez que usaste el sistema <strong>no cerraste sesión correctamente</strong>. Recuerda siempre hacer clic en <strong>Salir</strong> antes de irte para que quede registrada tu salida.</span>
        <button style="background:none;border:none;color:inherit;font-size:1rem;cursor:pointer;margin-left:auto;opacity:.7;" class="fs-3" title="Cerrar">×</button>
    </div>
}

@if (posSessionService.ShowBillingWarning)
{
    int days = posSessionService.BillingDaysLeft!.Value;
    <div class="billing-alert @(days <= 0 ? "billing-alert-danger" : "billing-alert-warning")">
        <i class="fas fa-exclamation-triangle"></i>
        @if (days <= 0)
        {
            <span>Tu cuenta está <strong>vencida</strong>. Renovála para seguir usando el sistema.</span>
        }
        else
        {
            <span>Te quedan <strong>@days día@(days == 1 ? "" : "s")</strong> para renovar tu suscripción antes de que se desactive tu cuenta.</span>
        }
        <a href="/pagar" target="_blank" class="billing-alert-btn">
            <i class="fas fa-money-bill-wave"></i> Pagar ahora
        </a>
    </div>
}

@code {

    [Parameter] public EventCallback OnCircuitReady { get; set; }
    [Parameter] public string Subtitle { get; set; } = "Punto de Venta";

    private DotNetObjectReference<_Header>? _dotNetRef;
    private bool   _registered;
    private bool   _dropdownOpen;
    private string _specialMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _specialMessage = await configRepository.GetValueAsync("special_message_from_root_to_all_users") ?? "";
        }
        catch { }
    }

    protected override void OnInitialized()
    {
        posSessionService.OnSessionChanged += HandleSessionChanged;
        posSessionService.OnStoreChanged   += HandleStoreChanged;
    }

    private async void HandleSessionChanged() => await InvokeAsync(StateHasChanged);
    private async void HandleStoreChanged()   => await InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _registered) return;
        _registered = true;
        _dotNetRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("hotkeyHelper.register", _dotNetRef);
        await OnCircuitReady.InvokeAsync();
    }

    [JSInvokable]
    public void OnKeyPressed(string key) => hotkeyService.Dispatch(key);

    private void ToggleDropdown() => _dropdownOpen = !_dropdownOpen;
    private void CloseDropdown()  => _dropdownOpen = false;

    private void SwitchStore(FiyiPOS.Areas.FiyiPOS.Common.StoreBack.Entities.Store store)
    {
        posSessionService.SwitchStore(store.StoreId, store.Name);
        posSessionService.SetBillingDueDate(store.BillingDueDate);
        _dropdownOpen = false;
    }

    public async ValueTask DisposeAsync()
    {
        posSessionService.OnSessionChanged -= HandleSessionChanged;
        posSessionService.OnStoreChanged   -= HandleStoreChanged;
        try { await JS.InvokeVoidAsync("hotkeyHelper.dispose"); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        _dotNetRef?.Dispose();
    }
}
